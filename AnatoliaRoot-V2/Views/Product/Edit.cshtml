@model AnatoliaRoot_V2.Models.ProductCreateViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ürün Güncelle";
    var imageUrl = ViewBag.ImageUrl as string;
}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-edit"></i> Ürün Güncelle
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" enctype="multipart/form-data" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Ürün Adı *</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AnaCategoryId" class="form-label fw-bold">Ana Kategori *</label>
                            <select asp-for="AnaCategoryId" class="form-select" id="anaKategoriSelect">
                                <option value="">Ana Kategori Seçiniz</option>
                                @foreach (var ana in Model.AnaKategoriler)
                                {
                                    <option value="@ana.Id">@ana.Name</option>
                                }
                            </select>
                            <span asp-validation-for="AnaCategoryId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="AltCategoryId" class="form-label fw-bold">Alt Kategori *</label>
                            <select asp-for="AltCategoryId" class="form-select" id="altKategoriSelect">
                                <option value="">Alt Kategori Seçiniz</option>
                                @foreach (var alt in Model.AltKategoriler.Where(a => a.ParentCategoryId != null))
                                {
                                    <option value="@alt.Id" data-parent="@alt.ParentCategoryId">@alt.Name</option>
                                }
                            </select>
                            <span asp-validation-for="AltCategoryId" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Yeni Resim Seç</label>
                            <input name="ImageFile" type="file" class="form-control" accept="image/*" onchange="previewEditImage(event)" />
                        </div>
                        <div class="mb-3 text-center">
                            <img id="editPreview" src="@ViewBag.ImageUrl" alt="Mevcut Resim" class="img-thumbnail" style="max-width: 200px;" />
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="AdminIndex" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Geri Dön
                            </a>
                            <button type="submit" class="btn btn-warning">
                                <i class="fas fa-save"></i> Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            function updateAltKategoriler() {
                var anaId = $('#anaKategoriSelect').val();
                $('#altKategoriSelect option').each(function() {
                    var parentId = $(this).data('parent');
                    if (typeof parentId === 'undefined') {
                        if ($(this).val() === "") $(this).show(); // ilk option
                        return;
                    }
                    if (anaId && String(parentId) === String(anaId)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                        if ($(this).is(':selected')) {
                            $(this).prop('selected', false);
                        }
                    }
                });
            }
            $('#anaKategoriSelect').on('change', updateAltKategoriler);
            updateAltKategoriler();
        });
        function previewEditImage(event) {
            const preview = document.getElementById("editPreview");
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        }
    </script>
}
