@{
    ViewData["Title"] = "AnatoliaRoot Dünyası";
}

<!-- Hero Section -->
<div class="relative">
    <div class="owl-navigation owl-carousel owl-theme">
        <div class="item">
            <div class="header-content bck" role="banner" style="background-image: url('https://res.cloudinary.com/dbhogeepn/image/upload/v1750509157/dunyaharitasi_c2ceps.jpg'); height: 50px; min-height: 150px; max-height: 80vh; background-size: cover; background-position: center;">
                <div class="container opac">
                    <div class="row">
                        <div class="col-xs-12 col-sm-12 header-area">
                            <div class="header-area-inner header-text hero-text-container">
                                <h1 class="hero-heading">SİTEMİZ YAPIM AŞAMASINDADIR</h1>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Anatolia World Info Section -->
<div class="container my-5 anatolia-info-section">
    <div class="row align-items-center">
        <!-- Sol: Açıklama Yazısı -->
        <div class="col-lg-7 col-md-6 mb-4 mb-lg-0">
            <h3 class="mb-3 anatolia-title" style="font-weight:700; color:#2d2d2d;">Anadolu'nun Bereketi, Modern Hizmetlerle Buluşuyor</h3>
            <p class="anatolia-text" style="font-size:1.15rem; color:#444;">
                Anadolu'nun bereketli topraklarında yetişen doğal ve kaliteli ürünlerin satışını yapıyoruz. Ayrıca <b>peyzaj hizmetleri</b> ile yaşam alanlarınızı güzelleştiriyor, <b>danışmanlık</b> ve <b>tedarik</b> hizmetlerimizle iş ortaklarımıza sürdürülebilir çözümler sunuyoruz. Anadolu'nun zenginliğini, modern hizmet anlayışıyla birleştirerek sizlere ulaştırıyoruz.
            </p>
        </div>
        <!-- Sağ: Görsel -->
        <div class="col-lg-5 col-md-6 text-center">
            <img src="https://res.cloudinary.com/dbhogeepn/image/upload/v1753453326/business-8941891_1280_jclsxg.jpg" alt="Anadolu Hizmetleri" class="img-fluid rounded shadow" style="max-height:320px; object-fit:cover;" loading="lazy" />
        </div>
    </div>
</div>


<!-- Projects Section -->
<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 15px; overflow: hidden;">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="fa fa-exchange me-2"></i> <strong>Döviz Kurları</strong>
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (ViewBag.ExchangeRate != null)
                    {
                        var kur = (AnatoliaRoot_V2.Models.ViewModels.ExchangeRateViewModel)ViewBag.ExchangeRate;
                        <table class="table table-hover mb-0 custom-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Sembol</th>
                                    <th class="text-end">Birim Fiyat</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span class="currency-badge">USD</span> ABD Doları</td>
                                    <td class="text-end fw-bold text-dark">@kur.UsdTry.ToString("N4") <small>TL</small></td>
                                </tr>
                                <tr>
                                    <td><span class="currency-badge">EUR</span> Euro</td>
                                    <td class="text-end fw-bold text-dark">@kur.EurTry.ToString("N4") <small>TL</small></td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="p-3 bg-light border-top">
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted"><i class="fa fa-clock-o"></i> @kur.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                <small class="badge bg-secondary opacity-75">@kur.Source</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center">
                            <i class="fa fa-exclamation-triangle text-warning mb-2" style="font-size: 2rem;"></i>
                            <p class="text-muted mb-0">Döviz bilgisi şu an alınamıyor.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6 mb-4">
            <div class="card shadow-sm border-0 h-100" style="border-radius: 15px; overflow: hidden;">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="mb-0 d-flex align-items-center">
                        <i class="fa fa-line-chart me-2"></i> <strong>Altın Piyasası</strong>
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (ViewBag.GoldPrice != null)
                    {
                        var altin = (AnatoliaRoot_V2.Models.ViewModels.GoldPriceViewModel)ViewBag.GoldPrice;
                        <table class="table table-hover mb-0 custom-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Altın Tipi</th>
                                    <th class="text-end">Fiyat (TL)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Gram Altın</td>
                                    <td class="text-end fw-bold text-dark">@altin.GramGold.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td>Çeyrek Altın</td>
                                    <td class="text-end fw-bold text-dark">@altin.QuarterGold.ToString("N2")</td>
                                </tr>
                                <tr>
                                    <td>Yarım Altın</td>
                                    <td class="text-end fw-bold text-dark">@altin.HalfGold.ToString("N2")</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="p-3 bg-light border-top">
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="gold-change">
                                    @if (altin.ChangeRate != 0)
                                    {
                                        <small class="fw-bold @(altin.ChangeRate > 0 ? "text-success" : "text-danger")">
                                            <i class="fa @(altin.ChangeRate > 0 ? "fa-caret-up" : "fa-caret-down")"></i>
                                            @(altin.ChangeRate > 0 ? "+" : "")@altin.ChangeRate.ToString("N2")%
                                        </small>
                                    }
                                </div>
                                <small class="text-muted">@altin.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center">
                            <i class="fa fa-exclamation-triangle text-warning mb-2" style="font-size: 2rem;"></i>
                            <p class="text-muted mb-0">Altın bilgisi şu an alınamıyor.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

