<style>
/* Kurlar için kart stilleri */
.card {
    border-radius: 1rem;
    border: none;
}

.card-header {
    border-radius: 1rem 1rem 0 0 !important;
    border-bottom: none;
}

.card-body {
    padding: 2rem;
}

h4, h5, h6 {
    margin-bottom: 0.5rem;
}

.text-success {
    color: #28a745 !important;
}

.text-danger {
    color: #dc3545 !important;
}

@@media (max-width: 768px) {
    .card-body {
        padding: 1.5rem;
    }
    
    .col-4 h5 {
        font-size: 1rem;
    }
}

.scroll-cards-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
}
.scroll-cards-row > .card {
    min-width: 260px;
    max-width: 320px;
    flex: 1 1 30%;
    height: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    border-radius: 1rem;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    background: #fff;
    margin-bottom: 0.5rem;
    transition: box-shadow 0.2s, transform 0.2s;
}
.scroll-cards-row > .card:hover {
