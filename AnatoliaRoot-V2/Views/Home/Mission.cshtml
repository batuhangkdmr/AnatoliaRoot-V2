@{
    ViewData["Title"] = "Misyonumuz";
}

<style>
    .kurumsal-baslik {
        text-align: left;
        font-weight: 700;
        margin-bottom: 1.5rem;
        background-color: #bbcfb9;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        display: inline-block;
    }
    .kurumsal-aciklama {
        text-align: left;
        max-width: 800px;
        margin-left: 0;
        margin-right: auto;
        font-size: 1.15rem;
        line-height: 1.7;
    }
    @@media (max-width: 991.98px) {
        .kurumsal-aciklama { max-width: 100%; }
    }
</style>

<div class="container py-5">
    <div class="mb-4">
        <h2 class="kurumsal-baslik">MİSYONUMUZ</h2>
        <p class="kurumsal-aciklama">Tokat'ın doğal ve taze ürünlerini, en sağlıklı ve güvenilir şekilde tüketicilerimize ulaştırmak.</p>
        <p class="kurumsal-aciklama">Gelenekten geleceğe uzanan bir köprü olarak, yöremizin lezzetlerini Türkiye'nin dört bir yanına taşımak.</p>
        <p class="kurumsal-aciklama">Her zaman kalite, hijyen ve müşteri memnuniyetini ön planda tutmak.</p>
    </div>
</div> 