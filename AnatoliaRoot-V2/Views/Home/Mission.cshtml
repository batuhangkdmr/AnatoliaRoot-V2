@{
    ViewData["Title"] = "Misyonumuz";
}

<style>
    .kurumsal-baslik {
        display: block;
        width: 100%;
        text-align: center;
        font-weight: 800;
        font-size: 2.5rem;
        margin-bottom: 2.5rem;
        padding: 1.5rem 0;
        border-radius: 1.5rem;
        background: linear-gradient(90deg, #bbcfb9 0%, #cdd9c8 100%);
        color: #222;
        box-shadow: 0 4px 24px 0 rgba(187,207,185,0.10);
        letter-spacing: 2px;
    }
    .kurumsal-aciklama {
        text-align: left;
        max-width: 900px;
        margin: 0 auto 1.5rem auto;
        font-size: 1.25rem;
        line-height: 1.8;
        color: #222;
    }
    @@media (max-width: 991.98px) {
        .kurumsal-baslik { font-size: 2rem; padding: 1rem 0; }
        .kurumsal-aciklama { font-size: 1.1rem; }
    }
</style>

<div class="container py-5">
    <div class="mb-4">
        <h2 class="kurumsal-baslik">MİSYONUMUZ</h2>
        <p class="kurumsal-aciklama">
            Yerel üreticilerimizin emeğini, modern pazarlama teknikleriyle tüm Türkiye'ye ve dünyaya ulaştırarak, Anadolu'nun değerlerini uluslararası pazarlara taşıyoruz.

            Kalite kontrol süreçlerimiz, sertifikasyonlarımız ve şeffaf iş modellerimizle müşteri güvenini en üst seviyede tutuyoruz. Her zaman en doğal, en taze ve güvenilir ürünleri sizlerle buluşturmak için çalışıyoruz.
        </p>
      @*   <p class="kurumsal-aciklama">Gelenekten geleceğe uzanan bir köprü olarak, yöremizin lezzetlerini Türkiye'nin dört bir yanına taşımak.</p>
        <p class="kurumsal-aciklama">Her zaman kalite, hijyen ve müşteri memnuniyetini ön planda tutmak.</p> *@
    </div>
</div> 