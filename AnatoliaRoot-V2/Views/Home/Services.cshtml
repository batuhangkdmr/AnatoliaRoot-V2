@{
    ViewData["Title"] = "Hizmetlerimiz";
}

<div class="wrap-bg-small">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <div class="section-title with-p">
                    <h2>HİZMETLERİMİZ</h2>
                    <p>Çeşitli sektörlerde kapsamlı hizmetler sunuyoruz.</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-4 col-md-6">
                <div class="single-features-light">
                    <i class="fa fa-cutlery"></i>
                    <h4>Gıda Ürünleri</h4>
                    <p>Tokat'ın yöresel gıda ürünlerini kaliteli şekilde sunuyoruz.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single-features-light">
                    <i class="fa fa-building"></i>
                    <h4>İnşaat Hizmetleri</h4>
                    <p>Profesyonel inşaat ve yapı hizmetleri veriyoruz.</p>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single-features-light">
                    <i class="fa fa-ship"></i>
                    <h4>İthalat & İhracat</h4>
                    <p>Uluslararası ticaret hizmetleri sunuyoruz.</p>
                </div>
            </div>
        </div>
    </div>
</div> 