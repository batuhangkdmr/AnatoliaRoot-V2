<script>
// Peyzaj form KVKK modal
const peyzajKvkkModalLink = document.getElementById('peyzajKvkkModalLink');
if (peyzajKvkkModalLink) {
    peyzajKvkkModalLink.addEventListener('click', function(e) {
        e.preventDefault();
        var modal = new bootstrap.Modal(document.getElementById('kvkkAydinlatmaModal'));
        modal.show();
    });
}
// Peyzaj form submit SweetAlert2
const peyzajForm = document.getElementById('peyzajForm');
if (peyzajForm) {
    peyzajForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        var peyzajKvkk = document.getElementById('peyzajKvkk');
        if (!peyzajKvkk.checked) {
            Swal.fire({
                icon: 'warning',
                title: 'Uyarı',
                text: 'Formu gönderebilmek için KVKK onay kutusunu işaretlemelisiniz.'
            });
            return;
        }
        const formData = new FormData(peyzajForm);
        try {
            const response = await fetch(peyzajForm.action, {
                method: 'POST',
                body: formData,
                headers: { 'Accept': 'application/json' }
            });
            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Başarılı!',
                    text: 'Peyzaj hizmeti talebiniz başarıyla gönderildi. En kısa sürede sizinle iletişime geçeceğiz.',
                    confirmButtonText: 'Tamam'
                });
                peyzajForm.reset();
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Hata',
                    text: 'Bir hata oluştu, lütfen tekrar deneyin.'
                });
            }
        } catch (err) {
            Swal.fire({
                icon: 'error',
                title: 'Hata',
                text: 'Bir hata oluştu, lütfen tekrar deneyin.'
            });
        }
    });
}
</script> 