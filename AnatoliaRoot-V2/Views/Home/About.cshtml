        <!-- Journey Section -->
        <section class="journey-section">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <div class="journey-content animate__animated animate__fadeInLeft">
                            <h2>Yolculuğumuz</h2>
                            <p class="lead">
                                Anadolu'nun köklü kültüründen ve bereketli topraklarından aldığımız ilhamla, 
                                yenilikçi ve sürdürülebilir çözümler sunuyoruz.
                            </p>
                            <p>
                                Binlerce yıllık geleneksel bilgiyi modern teknoloji ile birleştirerek, 
                                hem geçmişin değerlerini koruyor hem de geleceğe yönelik yenilikler getiriyoruz. 
                                Anadolu'nun bereketli topraklarından aldığımız güçle, sadece ürün değil, 
                                bir yaşam kültürü sunuyoruz.
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="journey-visual animate__animated animate__fadeInRight">
                            <div class="journey-timeline">
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <h5>Geleneksel Bilgi</h5>
                                        <p>Anadolu'nun binlerce yıllık kültürü</p>
                                    </div>
                                </div>
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <h5>Modern Teknoloji</h5>
                                        <p>Güncel teknikler ve yenilikler</p>
                                    </div>
                                </div>
                                <div class="timeline-item">
                                    <div class="timeline-dot"></div>
                                    <div class="timeline-content">
                                        <h5>Sürdürülebilir Gelecek</h5>
                                        <p>Çevre dostu ve kalıcı çözümler</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

<style>
/* Hero Section */
.about-hero {
    position: relative;
    background: linear-gradient(135deg, #d5ddd1 0%, #b1cfb1 100%);
    color: #123524;
    overflow: hidden;
}

.hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
}

.hero-pattern {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
        radial-gradient(circle at 25% 25%, rgba(177,207,177,0.13) 0%, transparent 50%),
        radial-gradient(circle at 75% 75%, rgba(213,221,209,0.13) 0%, transparent 50%);
    animation: float 20s ease-in-out infinite;
}

@@keyframes float {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(180deg); }
}

.hero-content {
    position: relative;
    z-index: 2;
}

.hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    text-shadow: 0 2px 4px rgba(0,0,0,0.08);
    color: #123524;
}

.hero-subtitle {
    font-size: 1.3rem;
    opacity: 0.9;
    font-weight: 300;
    margin-bottom: 2rem;
    font-style: italic;
    color: #388e3c;
}

.hero-description p {
    font-size: 1.1rem;
    line-height: 1.8;
    opacity: 0.95;
    margin-bottom: 0;
    color: #222;
}

/* Floating Elements */
.floating-elements {
    position: relative;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.floating-icon {
    position: absolute;
    width: 80px;
    height: 80px;
    background: rgba(177,207,177,0.22);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    color: #388e3c;
    backdrop-filter: blur(10px);
    animation: floatIcon 6s ease-in-out infinite;
    animation-delay: var(--delay);
    box-shadow: 0 4px 16px 0 rgba(187,207,185,0.10);
}

.floating-icon:nth-child(1) { top: 20%; left: 20%; }
.floating-icon:nth-child(2) { top: 60%; right: 20%; }
.floating-icon:nth-child(3) { bottom: 20%; left: 30%; }
.floating-icon:nth-child(4) { top: 40%; right: 40%; }

@@keyframes floatIcon {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-30px) rotate(180deg); }
}

.hero-logo-shape {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 420px;
    height: 420px;
    transform: translate(-50%, -55%);
    z-index: 1;
    pointer-events: none;
    filter: blur(0.5px);
}

/* Main Content */
.about-main {
    background: #f8f9fa;
}

/* Story Section */
.story-section {
    padding: 100px 0;
    background: white;
}

.section-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #123524;
    margin-bottom: 2rem;
    text-align: center;
    position: relative;
}

.section-title::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 80px;
    height: 4px;
    background: linear-gradient(135deg, #d5ddd1 0%, #b1cfb1 100%);
    border-radius: 2px;
}

.section-subtitle {
    font-size: 1.2rem;
    color: #388e3c;
    margin-bottom: 3rem;
    text-align: center;
}

.story-text .lead {
    font-size: 1.3rem;
    color: #123524;
    margin-bottom: 2rem;
    font-weight: 500;
}

.story-text p {
    font-size: 1.1rem;
    color: #388e3c;
    line-height: 1.8;
    margin-bottom: 1.5rem;
}

/* Values Section */
.values-section {
    padding: 100px 0;
    background: #f8f9fa;
}

.values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 40px;
    margin-top: 3rem;
}

.value-item {
    text-align: center;
    padding: 40px 20px;
    background: white;
    border-radius: 15px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
}

.value-item::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.1), transparent);
    transition: left 0.5s ease;
}

.value-item:hover::before {
    left: 100%;
}

.value-item:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
}

.value-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
    color: white;
    font-size: 2rem;
    transition: transform 0.3s ease;
}

.value-item:hover .value-icon {
    transform: scale(1.1);
}

.value-item h4 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 15px;
}

.value-item p {
    color: #6c757d;
    line-height: 1.6;
    margin-bottom: 0;
}

/* Journey Section */
.journey-section {
    padding: 100px 0;
    background: white;
}

.journey-content h2 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #123524;
    margin-bottom: 1.5rem;
    position: relative;
}

.journey-content h2::after {
    content: '';
    position: absolute;
    bottom: -10px;
    left: 0;
    width: 60px;
    height: 4px;
    background: linear-gradient(135deg, #d5ddd1 0%, #b1cfb1 100%);
    border-radius: 2px;
}

.journey-content .lead {
    font-size: 1.3rem;
    color: #123524;
    margin-bottom: 1.5rem;
    font-weight: 500;
}

.journey-content p {
    font-size: 1.1rem;
    color: #388e3c;
    line-height: 1.8;
    margin-bottom: 1rem;
}

/* Timeline */
.journey-timeline {
    position: relative;
    padding: 40px 0;
}

.journey-timeline::before {
    content: '';
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(135deg, #d5ddd1 0%, #b1cfb1 100%);
}

.timeline-item {
    position: relative;
    margin-bottom: 40px;
    padding-left: 60px;
}

.timeline-dot {
    position: absolute;
    left: 11px;
    top: 0;
    width: 20px;
    height: 20px;
    background: linear-gradient(135deg, #d5ddd1 0%, #b1cfb1 100%);
    border-radius: 50%;
    border: 4px solid white;
    box-shadow: 0 0 0 4px rgba(177,207,177,0.15);
}

.timeline-content {
    background: #f8f9fa;
    padding: 20px;
    border-radius: 10px;
    box-shadow: 0 5px 15px rgba(177,207,177,0.10);
}

.timeline-content h5 {
    font-size: 1.2rem;
    font-weight: 600;
    color: #123524;
    margin-bottom: 10px;
}

.timeline-content p {
    color: #388e3c;
    margin-bottom: 0;
    font-size: 0.95rem;
}

/* Animations */
.animate__delay-1s {
    animation-delay: 1s;
}

.animate__delay-2s {
    animation-delay: 2s;
}

.animate__delay-3s {
    animation-delay: 3s;
}

/* Responsive Design */
@@media (max-width: 768px) {
    .hero-title {
        font-size: 2.5rem;
    }
    
    .hero-subtitle {
        font-size: 1.1rem;
    }
    
    .floating-elements {
        height: 300px;
    }
    
    .floating-icon {
        width: 60px;
        height: 60px;
        font-size: 1.5rem;
    }
    
    .story-section,
    .values-section,
    .journey-section {
        padding: 60px 0;
    }
    
    .section-title {
        font-size: 2rem;
    }
    
    .values-grid {
        grid-template-columns: 1fr;
        gap: 30px;
    }
    
    .journey-content h2 {
        font-size: 2rem;
    }
}

@@media (max-width: 480px) {
    .hero-title {
        font-size: 2rem;
        margin-top: 15%;
        text-align: center;
    }
    
    .hero-subtitle {
        font-size: 1rem;
    }
    
    .floating-elements {
        height: 250px;
    }
    
    .floating-icon {
        width: 50px;
        height: 50px;
        font-size: 1.2rem;
    }
    
    .story-section,
    .values-section,
    .journey-section {
        padding: 40px 0;
    }
    
    .section-title {
        font-size: 1.8rem;
    }
    
    .journey-content h2 {
        font-size: 1.8rem;
    }
}
</style>

<script>
// Intersection Observer for animations
document.addEventListener('DOMContentLoaded', function() {
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver(function(entries) {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, observerOptions);

    // Observe all animated elements
    document.querySelectorAll('.animate__animated').forEach(el => {
        observer.observe(el);
    });
});
</script>
