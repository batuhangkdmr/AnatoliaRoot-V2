@{
    ViewData["Title"] = "Hakkımızda";
}

<div class="container-fluid p-0">
    <!-- Hero Section -->
    <div class="about-hero">
        <div class="hero-background">
            <div class="hero-pattern"></div>
        </div>
        <div class="hero-content">
            <div class="container">
                <div class="row align-items-center min-vh-70">
                    <div class="col-lg-6">
                        <div class="hero-text animate__animated animate__fadeInLeft">
                            <h1 class="hero-title">
                                Anadolu'nun İlhamı ve Enerjisi
                            </h1>
                            <p class="hero-subtitle">
                                Gelenekten geleceğe, Anadolu'nun bereketiyle...
                            </p>
                            <div class="hero-description">
                                <p>
                                    Anadolu, sadece bir coğrafya değil; ilhamın, emeğin ve yeniliğin buluşma noktasıdır. 
                                    Bu toprakların enerjisini ve çeşitliliğini işimize yansıtıyor, Anadolu'nun bereketini 
                                    ve kültürel zenginliğini sizlerle buluşturuyoruz.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="hero-visual animate__animated animate__fadeInRight">
                            <div class="floating-elements">
                                <div class="floating-icon" style="--delay: 0s;">
                                    <i class="fa fa-seedling"></i>
                                </div>
                                <div class="floating-icon" style="--delay: 1s;">
                                    <i class="fa fa-leaf"></i>
                                </div>
                                <div class="floating-icon" style="--delay: 2s;">
                                    <i class="fa fa-globe"></i>
                                </div>
                                <div class="floating-icon" style="--delay: 3s;">
                                    <i class="fa fa-handshake"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="about-main">
        <!-- Story Section -->
        <section class="story-section">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8 mx-auto">
                        <div class="story-content animate__animated animate__fadeInUp">
                            <h2 class="section-title">Hikayemiz</h2>
                            <div class="story-text">
                                <p class="lead">
                                    Yılların deneyimi ve Anadolu'nun zengin kültürüyle, gıda üretiminden satış-pazarlamaya, 
                                    ihracattan danışmanlığa kadar geniş bir yelpazede hizmet veriyoruz.
                                </p>
                                
                                <p>
                                    Yerel üreticilerimizin emeğini, modern pazarlama teknikleriyle tüm Türkiye'ye ve dünyaya 
                                    ulaştırıyoruz. Anadolu'nun değerlerini uluslararası pazarlara taşıyor, ülkemizin markasını 
                                    güçlendiriyoruz.
                                </p>
                                
                                <p>
                                    Gıda, dış ticaret ve peyzaj alanlarında uzman ekibimizle işinizi büyütmenize destek oluyoruz. 
                                    Doğayla uyumlu, sürdürülebilir ve estetik çözümler sunuyoruz.
                                </p>
                                
                                <p>
                                    Anadolu'nun ilhamı ve enerjisiyle, her zaman en iyisi ve yenisi için çalışıyoruz. 
                                    Sadece ürün değil, bir yaşam kültürü sunuyoruz. Geleceğe yönelik projelerimizle, 
                                    Anadolu'nun bereketini dünyaya taşımaya devam edeceğiz.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

