@{
    ViewData["Title"] = "Vizyonumuz";
}

<style>
    .kurumsal-baslik {
        display: block;
        width: 100%;
        text-align: center;
        font-weight: 800;
        font-size: 2.5rem;
        margin-bottom: 2.5rem;
        padding: 1.5rem 0;
        border-radius: 1.5rem;
        background: linear-gradient(90deg, #bbcfb9 0%, #cdd9c8 100%);
        color: #222;
        box-shadow: 0 4px 24px 0 rgba(187,207,185,0.10);
        letter-spacing: 2px;
    }
    .kurumsal-aciklama {
        text-align: center;
        max-width: 900px;
        margin: 0 auto 1.5rem auto;
        font-size: 1.25rem;
        line-height: 1.8;
        color: #222;
    }
    @@media (max-width: 991.98px) {
        .kurumsal-baslik { font-size: 2rem; padding: 1rem 0; }
        .kurumsal-aciklama { font-size: 1.1rem; }
    }
</style>

<div class="container py-5">
    <div class="mb-4">
        <h2 class="kurumsal-baslik">VİZYONUMUZ</h2>
        <p class="kurumsal-aciklama">Tokat'ın zengin gıda kültürünü modern üretim teknikleriyle birleştirerek sektörde öncü olmak.</p>
        <p class="kurumsal-aciklama">Yöresel ürünlerimizi ulusal ve uluslararası pazarlarda tanınır hale getirmek.</p>
        <p class="kurumsal-aciklama">Doğallık ve kaliteyi her zaman en üst seviyede tutmak.</p>
    </div>
</div>

@section Scripts {
    <script>
    $(document).ready(function(){
      $('#vizyon-carousel-1').owlCarousel({
          loop:true,
          margin:20,
          nav:true,
          dots:true,
          responsive:{
              0:{ items:1 },
              600:{ items:2 },
              1000:{ items:3 }
          }
      });
      $('#vizyon-carousel-2').owlCarousel({
          loop:true,
          margin:20,
          nav:true,
          dots:true,
          responsive:{
              0:{ items:1 },
              600:{ items:2 },
              1000:{ items:3 }
          }
      });
    });
    </script>
    <style>
    #vizyon-carousel-1 .card-img-top,
    #vizyon-carousel-2 .card-img-top {
        object-fit: cover;
        height: 200px;
    }
    </style>
} 