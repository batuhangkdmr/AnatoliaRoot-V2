@{
    ViewData["Title"] = "Kalite Politikamız";
}

<style>
    .kurumsal-baslik {
        text-align: left;
        font-weight: 700;
        margin-bottom: 1.5rem;
        background-color: #bbcfb9;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        display: inline-block;
    }
    .kurumsal-aciklama {
        text-align: left;
        max-width: 800px;
        margin-left: 0;
        margin-right: auto;
        font-size: 1.15rem;
        line-height: 1.7;
    }
    @@media (max-width: 991.98px) {
        .kurumsal-aciklama { max-width: 100%; }
    }
</style>

<div class="container py-5">
    <div class="mb-4">
        <h2 class="kurumsal-baslik">KALİTE POLİTİKAMIZ</h2>
        <p class="kurumsal-aciklama">Ürünlerimizin her aşamasında hijyen, doğallık ve kaliteyi ön planda tutuyoruz.</p>
        <p class="kurumsal-aciklama">Tokat'ın verimli topraklarından elde edilen hammaddelerle, güvenilir ve sağlıklı gıda üretimi yapıyoruz.</p>
        <p class="kurumsal-aciklama">Müşteri memnuniyeti ve sürdürülebilir kalite anlayışıyla hizmet veriyoruz.</p>
    </div>
</div> 