@{
    ViewData["Title"] = "İletişim";
}

<div class="wrap-bg-small">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <div class="section-title with-p">
                    <h2>İLETİŞİM</h2>
                    <p>Bizimle iletişime geçin.</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6">
                <div class="contact-info">
                    <h4>İletişim Bilgileri</h4>
                    <div class="contact-item">
                        <i class="fa fa-phone"></i>
                        <p><a href="tel:+90 532 399 72 60">0532 399 72 60</a></p>
                    </div>
                    <div class="contact-item">
                        <i class="fa fa-envelope"></i>
                        <p><a href="mailto:info@anatoliaroot.com">info@anatoliaroot.com</a></p>
                    </div>
                    <div class="contact-item">
                        <i class="fa fa-map-marker"></i>
                        <p>Tokat Merkez</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="contact-form">
                    <h4>Mesaj Gönderin</h4>
                    <form>
                        <div class="form-group">
                            <input type="text" class="form-control" placeholder="Adınız" required>
                        </div>
                        <div class="form-group">
                            <input type="email" class="form-control" placeholder="E-posta" required>
                        </div>
                        <div class="form-group">
                            <textarea class="form-control" rows="5" placeholder="Mesajınız" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-custom">Gönder</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div> 