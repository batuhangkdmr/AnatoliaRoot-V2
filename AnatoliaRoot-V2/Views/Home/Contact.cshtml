@{
    ViewData["Title"] = "İletişim";
}

<div class="wrap-bg-small">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <div class="section-title with-p">
                    <h2>İLETİŞİM</h2>
                    <p>Bizimle iletişime geçin.</p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-lg-6">
                <div class="contact-info">
                    <h4>İletişim Bilgileri</h4>
                    <div class="contact-item">
                        <i class="fa fa-phone"></i>
                        <p><a href="tel:+90 532 399 72 60">0532 399 72 60</a></p>
                    </div>
                    <div class="contact-item">
                        <i class="fa fa-envelope"></i>
                        <p><a href="mailto:info@anatoliaroot.com">info@anatoliaroot.com</a></p>
                    </div>
                    <div class="contact-item">
                        <i class="fa fa-map-marker"></i>
                        <p>Tokat Merkez</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="contact-form">
                    <h4>Mesaj Gönderin</h4>
                    <form id="contactForm" action="https://formspree.io/f/xldlrpza" method="POST">
                        
                        <div class="form-group">
                            <input type="text" class="form-control" name="adSoyad" placeholder="Adınız" required>
                        </div>
                        <div class="form-group">
                            <input type="email" class="form-control" name="eposta" placeholder="E-posta" required>
                        </div>
                        <div class="form-group">
                            <textarea class="form-control" name="mesaj" rows="5" placeholder="Mesajınız" required></textarea>
                        </div>
                        <button type="submit" class="btn btn-custom">Gönder</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const contactForm = document.getElementById('contactForm');
    
    contactForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Show loading state
        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.textContent;
        submitBtn.textContent = 'Gönderiliyor...';
        submitBtn.disabled = true;
        
        try {
            const formData = new FormData(this);
            
            // Sadece formSource alanını ekle (Türkçe ve tek)
            formData.append('formSource', 'İletişim Sayfası');
            
            const response = await fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: { 'Accept': 'application/json' }
            });
            
            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Mesajınız Başarıyla Gönderildi!',
                    text: 'Mesajınız yönetici ekibimize iletildi. En kısa sürede size geri dönüş yapılacaktır.',
                    confirmButtonText: 'Teşekkürler'
                });
                this.reset();
            } else {
                throw new Error('Form gönderilemedi');
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Bir Hata Oluştu',
                text: 'Mesajınız gönderilirken bir hata oluştu. Lütfen tekrar deneyin.',
                confirmButtonText: 'Tamam'
            });
        } finally {
            submitBtn.textContent = originalText;
            submitBtn.disabled = false;
        }
    });
});
</script> 