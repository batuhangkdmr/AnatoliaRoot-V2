@{
    ViewData["Title"] = "İletişim - Anadolu Mirası";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    :root {
        --primary: #b1cfb1;
        --primary-dark: #8ba88b;
        --accent: #388e3c;
        --bg-soft: #f4f8f4;
        --white: #ffffff;
        --dark: #1e2d1e;
        --transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    body {
        background: var(--bg-soft);
        font-family: 'Inter', sans-serif;
        color: var(--dark);
        margin: 0;
    }

    /* --- Hero Section Fix --- */
    .contact-hero {
        position: relative;
        height: 60vh; /* Masaüstünde daha ferah bir görünüm */
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        /* GÖRSEL GÜNCELLEMESİ VE RESPONSIVE AYARLARI */
        background: linear-gradient(rgba(30, 45, 30, 0.6), rgba(30, 45, 30, 0.6)), url('/images/galeri-tokat.webp');
        background-size: cover;
        background-position: center center; /* Resmi merkeze odaklar */
        background-attachment: fixed; /* Masaüstü Parallax */
        background-repeat: no-repeat;
        width: 100%;
    }

    /* Mobilde Parallax'ı kapatıp resmi tam sığdıracak yükseklik ayarı */
    @@media (max-width: 768px) {
        .contact-hero {
            height: 45vh; /* Mobilde daha orantılı yükseklik */
            background-attachment: scroll; /* Mobilde resmin aşırı büyümesini engeller */
            background-position: center center;
        }
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2.5rem, 8vw, 5rem);
        margin: 0;
        letter-spacing: -2px;
        position: relative;
        z-index: 2;
    }

    /* --- Main Content Structure --- */
    .main-wrapper {
        max-width: 1400px;
        margin: -80px auto 100px; /* Hero üzerine taşma payı */
        padding: 0 20px;
        position: relative;
        z-index: 10;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
    }

    /* --- Left Side: Story & Brand --- */
    .info-column {
        display: flex;
        flex-direction: column;
        gap: 30px;
    }

    .glass-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(10px);
        border-radius: 30px;
        padding: 40px;
        border: 1px solid rgba(177, 207, 177, 0.3);
        box-shadow: 0 20px 40px rgba(0,0,0,0.05);
        transition: var(--transition);
    }

    .brand-story h2 {
        font-family: 'Playfair Display', serif;
        color: var(--accent);
        margin-bottom: 20px;
        font-size: 2.2rem;
    }

    .brand-story p {
        line-height: 1.8;
        color: #555;
        font-size: 1.05rem;
    }

    .pillar-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-top: 10px;
    }

    .pillar-item {
        background: var(--bg-soft);
        padding: 25px;
        border-radius: 20px;
        text-align: center;
        transition: var(--transition);
    }

        .pillar-item:hover {
            background: var(--primary);
            transform: scale(1.05);
        }

        .pillar-item i {
            font-size: 2rem;
            color: var(--accent);
            margin-bottom: 15px;
            display: block;
        }

        .pillar-item h5 {
            margin: 0 0 5px;
            font-weight: 700;
            color: var(--dark);
        }

        .pillar-item span {
            font-size: 0.85rem;
            color: #666;
        }

    .direct-contact {
        display: flex;
        gap: 20px;
        margin-top: auto;
    }

    .contact-bubble {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 15px;
        background: var(--white);
        padding: 20px;
        border-radius: 20px;
        border: 1px solid #eee;
    }

    .bubble-icon {
        width: 50px;
        height: 50px;
        background: var(--primary);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1.2rem;
    }

    .bubble-info small {
        display: block;
        color: #999;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .bubble-info a, .bubble-info span {
        font-weight: 600;
        color: var(--dark);
        text-decoration: none;
        font-size: 0.95rem;
    }

    /* --- Right Side: Modern Form --- */
    .form-card {
        background: var(--white);
        border-radius: 35px;
        padding: 60px;
        box-shadow: 0 30px 60px rgba(74, 103, 65, 0.15);
        border: 2px solid var(--primary);
        position: sticky;
        top: 30px;
    }

    .form-header {
        margin-bottom: 40px;
    }

        .form-header h3 {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            margin-bottom: 10px;
        }

    .form-group {
        margin-bottom: 25px;
        position: relative;
    }

    .floating-input {
        width: 100%;
        padding: 15px 20px;
        border-radius: 15px;
        border: 2px solid #f0f0f0;
        background: #f9fbf9;
        font-size: 1rem;
        outline: none;
        transition: var(--transition);
        font-family: inherit;
        box-sizing: border-box;
    }

        .floating-input:focus {
            border-color: var(--primary);
            background: white;
            box-shadow: 0 10px 20px rgba(177, 207, 177, 0.2);
        }

    .kvkk-area {
        margin: 25px 0;
    }

    .kvkk-check {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 12px;
        cursor: pointer;
        text-align: left;
    }

        .kvkk-check input {
            width: 18px;
            height: 18px;
            accent-color: var(--accent);
            cursor: pointer;
            margin-top: 3px;
            flex-shrink: 0;
        }

        .kvkk-check label {
            font-size: 0.85rem;
            color: #666;
            line-height: 1.4;
            cursor: pointer;
        }

        .kvkk-check a {
            color: var(--accent);
            font-weight: 600;
            text-decoration: none;
            border-bottom: 1px dashed var(--accent);
        }

    .submit-btn {
        width: 100%;
        background: linear-gradient(135deg, var(--accent), var(--primary-dark));
        color: white;
        border: none;
        padding: 20px;
        border-radius: 18px;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        transition: var(--transition);
        box-shadow: 0 15px 30px rgba(56, 142, 60, 0.2);
    }

        .submit-btn:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(56, 142, 60, 0.3);
        }

    /* --- Responsive Fixes --- */
    @@media (max-width: 992px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }

        .main-wrapper {
            margin-top: -60px;
            margin-bottom: 50px;
        }

        .form-card {
            padding: 40px 30px;
            position: static;
        }
    }

    @@media (max-width: 576px) {
        .pillar-grid {
            grid-template-columns: 1fr;
        }

        .direct-contact {
            flex-direction: column;
        }

        .hero-title {
            font-size: 2.8rem;
        }

        .glass-card {
            padding: 30px 20px;
        }
    }

    /* Modals */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.85);
        backdrop-filter: blur(10px);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 10000;
    }

    .modal-box {
        background: white;
        border-radius: 30px;
        padding: 50px;
        text-align: center;
        max-width: 500px;
        width: 90%;
        transform: scale(0.9);
        transition: 0.3s;
    }
</style>

<section class="contact-hero">
    <div class="hero-content animate__animated animate__zoomIn">
        <span class="hero-badge animate__animated animate__fadeInDown" style="background: var(--primary); padding: 5px 15px; border-radius: 50px; font-size: 0.8rem; font-weight: 700; color: #2d3e2d;">BİZE ULAŞIN</span>
        <h1 class="hero-title">Geleceği Birlikte <br><span>İnşa Edelim</span></h1>
    </div>
</section>

<div class="main-wrapper">
    <div class="contact-grid">

        <div class="info-column animate__animated animate__fadeInLeft">

            <div class="glass-card brand-story">
                <h2>Anadolu'nun Enerjisi</h2>
                <p>Anadolu, sadece bir coğrafya değil; ilhamın, emeğin ve yeniliğin buluşma noktasıdır. Binlerce yıllık bilgiyi modern teknoloji ile harmanlayarak Anadolu'nun bereketini dünyaya taşıyoruz.</p>

                <div class="pillar-grid">
                    <div class="pillar-item">
                        <i class="fa-solid fa-seedling"></i>
                        <h5>Geleneksel Bilgi</h5>
                        <span>Kadim Kültür</span>
                    </div>
                    <div class="pillar-item">
                        <i class="fa-solid fa-microchip"></i>
                        <h5>Modern Teknoloji</h5>
                        <span>Yenilikçi Teknikler</span>
                    </div>
                    <div class="pillar-item">
                        <i class="fa-solid fa-earth-americas"></i>
                        <h5>Global Vizyon</h5>
                        <span>İhracat Gücü</span>
                    </div>
                    <div class="pillar-item">
                        <i class="fa-solid fa-leaf"></i>
                        <h5>Sürdürülebilir</h5>
                        <span>Doğa Dostu</span>
                    </div>
                </div>
            </div>

            <div class="direct-contact">
                <div class="contact-bubble">
                    <div class="bubble-icon"><i class="fa-solid fa-phone"></i></div>
                    <div class="bubble-info">
                        <small>Müşteri Hattı</small>
                        <a href="tel:+905323997260">+90 532 399 72 60</a>
                    </div>
                </div>
                <div class="contact-bubble">
                    <div class="bubble-icon"><i class="fa-solid fa-envelope"></i></div>
                    <div class="bubble-info">
                        <small>Destek Talebi</small>
                        <a href="mailto:info@anatoliaroot.com">info@anatoliaroot.com</a>
                    </div>
                </div>
            </div>

            <div class="glass-card" style="padding: 20px;">
                <div style="display: flex; align-items: center; gap: 15px;">
                    <div class="bubble-icon" style="background: var(--accent);"><i class="fa-solid fa-location-dot"></i></div>
                    <div>
                        <h5 style="margin:0; font-size: 1rem;">Genel Merkez</h5>
                        <p style="margin:0; font-size: 0.85rem; color:#666;">Tokat Merkez, Türkiye</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-column animate__animated animate__fadeInRight">
            <div class="form-card">
                <div class="form-header">
                    <h3>Mesaj Bırakın</h3>
                    <p style="color: #888;">Anadolu'nun bereketli projelerinde birlikte yürüyelim.</p>
                </div>

                <form action="https://formspree.io/f/xldlrpza" method="POST" id="contactForm">
                    <div class="form-group">
                        <input type="text" name="adSoyad" class="floating-input" placeholder="Adınız ve Soyadınız" required>
                    </div>
                    <div class="form-group">
                        <input type="email" name="Mail" class="floating-input" placeholder="E-Posta Adresiniz" required>
                    </div>
                    <div class="form-group">
                        <input type="text" name="konu" class="floating-input" placeholder="Konu" required>
                    </div>
                    <div class="form-group">
                        <textarea name="mesaj" class="floating-input" placeholder="Mesajınız..." rows="4" required></textarea>
                    </div>

                    <div class="kvkk-area">
                        <div class="kvkk-check">
                            <input type="checkbox" id="kvkk1" required>
                            <label for="kvkk1"><a href="#" onclick="openKvkk('kvkkAydinlatmaModal')">KVKK Aydınlatma Metni</a>'ni okudum.</label>
                        </div>
                        <div class="kvkk-check">
                            <input type="checkbox" id="kvkk2" required>
                            <label for="kvkk2"><a href="#" onclick="openKvkk('kvkkRizaModal')">Açık Rıza Metni</a> çerçevesinde onay veriyorum.</label>
                        </div>
                    </div>

                    <button type="submit" class="submit-btn" id="submitBtn">
                        <span>Gönderiyi Tamamla</span>
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal-overlay" id="successModal">
    <div class="modal-box">
        <div style="font-size: 4rem; color: var(--accent); margin-bottom: 20px;"><i class="fa-solid fa-circle-check"></i></div>
        <h2 style="font-family: 'Playfair Display';">Mesajınız İletildi!</h2>
        <p>Anadolu'nun bereketiyle mesajınız bize ulaştı. En kısa sürede sizinle iletişime geçeceğiz.</p>
        <button class="submit-btn" onclick="closeModal('successModal')">Tamam</button>
    </div>
</div>

<div class="modal-overlay" id="errorModal">
    <div class="modal-box">
        <div style="font-size: 4rem; color: #d32f2f; margin-bottom: 20px;"><i class="fa-solid fa-circle-exclamation"></i></div>
        <h2>Hata Oluştu</h2>
        <p>Mesajınızı şu an alamıyoruz. Lütfen bağlantınızı kontrol edip tekrar deneyin.</p>
        <button class="submit-btn" style="background: #333;" onclick="closeModal('errorModal')">Tekrar Dene</button>
    </div>
</div>

<div class="modal fade" id="kvkkAydinlatmaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius: 25px; padding: 20px; border:none;">
            <div class="modal-header"><h5>KVKK Aydınlatma Metni</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" style="color:#555; line-height:1.6;">
                <p>Bu metin, 6698 sayılı Kişisel Verilerin Korunması Kanunu ("KVKK") kapsamında tarafımıza ilettiğiniz verileriniz hakkında sizi bilgilendirmek amacıyla hazırlanmıştır.</p>

                <h5>1. Veri İşleme Amacı</h5>
                <p>İletişim formunda paylaştığınız bilgiler; yalnızca talebinizin değerlendirilmesi, hizmetlerimizin planlanması ve size geri dönüş yapılması amacıyla işlenmektedir.</p>

                <h5>2. Veri Güvenliği ve Paylaşım</h5>
                <p>Kişisel verileriniz hiçbir şekilde üçüncü kişilerle paylaşılmaz, ticari amaçla satılmaz. Verileriniz, güvenlik standartlarımıza uygun sunucularda saklanmaktadır.</p>

                <h5>3. Yasal Haklarınız</h5>
                <ul>
                    <li>Verilerinizin işlenip işlenmediğini öğrenme,</li>
                    <li>Eksik veya yanlış işlenen verilerin düzeltilmesini isteme,</li>
                    <li>KVKK md. 11 çerçevesinde verilerin silinmesini talep etme hakkına sahipsiniz.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="kvkkRizaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 25px; padding: 20px; border:none;">
            <div class="modal-header"><h5>Açık Rıza Metni</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" style="color:#555; line-height:1.6;">
                <p>AnatoliaRoot tarafından sunulan Aydınlatma Metni'ni okuduğumu ve verilerimin belirtilen amaçlar doğrultusunda işlenmesini kabul ettiğimi beyan ederim.</p>
                <p>Bu kapsamda; paylaştığım bilgilerin taleplerimin karşılanması amacıyla kaydedilmesine <b>açık rızam ile onay veriyorum.</b></p>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const form = document.getElementById('contactForm');
    const submitBtn = document.getElementById('submitBtn');

    form.addEventListener('submit', function(e) {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Gönderiliyor...</span> <i class="fa-solid fa-spinner fa-spin"></i>';

        fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { 'Accept': 'application/json' }
        })
        .then(response => {
            if (response.ok) {
                showStatusModal('successModal');
                form.reset();
            } else {
                showStatusModal('errorModal');
            }
        })
        .catch(() => showStatusModal('errorModal'))
        .finally(() => {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<span>Gönderiyi Tamamla</span> <i class="fa-solid fa-paper-plane"></i>';
        });
    });

    function showStatusModal(id) {
        const modal = document.getElementById(id);
        modal.style.display = 'flex';
        setTimeout(() => { modal.querySelector('.modal-box').style.transform = 'scale(1)'; }, 10);
    }

    function closeModal(id) {
        const modal = document.getElementById(id);
        modal.querySelector('.modal-box').style.transform = 'scale(0.8)';
        setTimeout(() => { modal.style.display = 'none'; }, 300);
    }

    function openKvkk(id) {
        new bootstrap.Modal(document.getElementById(id)).show();
    }
</script>