@model AnatoliaRoot_V2.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Admin Kayıt";
}
<div class="container py-5">
    <h2>Admin Kayıt</h2>
    <form asp-action="Register" method="post" class="mt-4" autocomplete="off">
        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SecretKey" class="form-label"></label>
            <input asp-for="SecretKey" class="form-control" />
            <span asp-validation-for="SecretKey" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Kayıt Ol</button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 