@model AnatoliaRoot_V2.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Admin Giriş";
}
<div class="container py-5">
    <h2>Admin Giriş</h2>
    <form asp-action="Login" method="post" class="mt-4" autocomplete="off">
        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Giriş Yap</button>
            <a href="/Account/Register" class="btn btn-outline-secondary">Kayıt Ol</a>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
} 