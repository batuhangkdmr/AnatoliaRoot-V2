@{
    ViewData["Title"] = "Anadolu'nun Tarihsel Yolculuğu - Resim Galerisi";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Inter:wght@300;400;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --primary: #4A6741;
        --primary-light: #adcbae;
        --dark: #121212;
        --light: #fdfdfd;
        --glass: rgba(255, 255, 255, 0.95);
        --transition: all 0.5s cubic-bezier(0.19, 1, 0.22, 1);
    }

    body {
        background: var(--light);
        font-family: 'Inter', sans-serif;
        margin: 0;
        color: var(--dark);
        overflow-x: hidden;
    }

    /* --- Global Container --- */
    .gallery-main-wrapper {
        max-width: 1300px;
        margin: 0 auto;
        width: 100%;
        box-sizing: border-box;
    }

    /* --- Hero Section - Responsive Fix --- */
    .gallery-hero {
        position: relative;
        width: 100%;
        /* Masaüstünde daha ferah, mobilde daha kompakt yükseklik */
        height: 80vh;
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        /* Görsel Yolu ve Yerleşimi */
        background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/images/galeri-tokat.webp');
        background-size: cover;
        background-position: center center;
        background-repeat: no-repeat;
        background-attachment: fixed; /* Masaüstü için Parallax etkisi */
    }

    /* MOBİL İÇİN ÖZEL DÜZENLEME */
    @@media (max-width: 768px) {
        .gallery-hero {
            height: 40vh; /* Mobilde dikeyde daha az yer kaplar */
            min-height: 300px;
            background-attachment: scroll; /* Mobilde görselin aşırı büyümesini engeller */
            background-position: center center;
        }
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.2); /* Görselin üzerine hafif bir derinlik katar */
    }

    .hero-container {
        position: relative;
        z-index: 5;
        padding: 0 20px;
    }

    .gallery-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(2rem, 7vw, 4rem);
        margin: 0 0 10px;
        text-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

        .gallery-title span {
            color: var(--primary-light);
            font-style: italic;
        }

    .hero-badge {
        background: var(--primary);
        padding: 6px 18px;
        border-radius: 50px;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.75rem;
        margin-bottom: 15px;
        display: inline-block;
        letter-spacing: 1px;
    }

    /* --- Galeri Grid --- */
    .gallery-container {
        padding: 30px 0;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 20px;
        padding: 0 20px;
    }

    @@media (max-width: 480px) {
        .gallery-grid {
            grid-template-columns: 1fr;
        }
    }

    .gallery-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 6px 15px rgba(0,0,0,0.03);
        transition: var(--transition);
        cursor: pointer;
        border: 1px solid rgba(0,0,0,0.02);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .gallery-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(74, 103, 65, 0.12);
        }

    .image-box {
        position: relative;
        height: 200px;
        overflow: hidden;
    }

        .image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 1.2s;
        }

    .card-tag {
        position: absolute;
        top: 10px;
        left: 10px;
        background: var(--glass);
        padding: 3px 10px;
        border-radius: 6px;
        font-weight: 800;
        color: var(--primary);
        font-size: 0.75rem;
        z-index: 2;
    }

    .card-content {
        padding: 15px;
        flex-grow: 1;
    }

        .card-content h3 {
            font-size: 1.1rem;
            color: var(--primary);
            margin: 0 0 8px 0;
            font-weight: 700;
            line-height: 1.3;
        }

    .card-description {
        font-size: 0.85rem;
        color: #666;
        line-height: 1.5;
        margin: 0;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* --- Modal --- */
    .master-modal {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 9999;
        background: rgba(0,0,0,0.92);
        backdrop-filter: blur(10px);
        display: none;
        align-items: center;
        justify-content: center;
        padding: 15px;
        cursor: zoom-out;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

        .master-modal.active {
            opacity: 1;
            display: flex;
        }

    .modal-main-container {
        width: 95%;
        max-width: 1000px;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        max-height: 80vh;
    }

    .modal-image-wrapper {
        background: #000;
        height: 250px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .modal-image-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .modal-text-panel {
        padding: 20px;
        background: #fff;
        overflow-y: auto;
        flex-grow: 1;
    }

    .m-year {
        font-weight: 900;
        color: var(--primary);
        font-size: 1.3rem;
        display: block;
        margin-bottom: 5px;
    }

    .modal-text-panel h2 {
        font-family: 'Playfair Display', serif;
        font-size: 1.4rem;
        margin: 0 0 10px 0;
        line-height: 1.2;
    }

    .m-divider {
        border: 0;
        height: 3px;
        width: 30px;
        background: var(--primary-light);
        margin: 0 0 10px;
    }

    .modal-text-panel p {
        font-size: 0.95rem;
        color: #555;
        line-height: 1.6;
    }

    @@media (min-width: 992px) {
        .modal-main-container {
            flex-direction: row;
            height: 60vh;
            width: 90%;
        }

        .modal-image-wrapper {
            height: 100%;
            flex: 1.3;
        }

        .modal-text-panel {
            padding: 40px;
            flex: 1;
        }

            .modal-text-panel h2 {
                font-size: 2rem;
            }

        .image-box {
            height: 220px;
        }
    }

    .animate-on-scroll {
        opacity: 0;
        transform: translateY(20px);
        transition: 0.6s var(--transition);
    }

        .animate-on-scroll.show {
            opacity: 1;
            transform: translateY(0);
        }
</style>

