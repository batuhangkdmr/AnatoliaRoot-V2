@{
    ViewData["Title"] = "Anadolu'nun Tarihsel Yolculuğu - Resim Galerisi";
}

<!-- Hero Section -->
<div class="gallery-hero">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-10">
                <h1 class="gallery-title">ANADOLU'NUN TARİHSEL YOLCULUĞU</h1>
                <p class="gallery-subtitle">1950'den Günümüze Anadolu'nun Bereketli Topraklarından Hikayeler</p>
            </div>
        </div>
    </div>
</div>

<!-- Timeline Navigation -->
<div class="timeline-navigation">
    <div class="container">
        <div class="timeline-nav-wrapper">
            <div class="timeline-nav">
                <button class="decade-btn active" data-decade="all">
                    <span class="decade-number">Tümü</span>
                    <span class="decade-label">1950-2024</span>
                </button>

                <button class="decade-btn" data-decade="1950">
                    <span class="decade-number">1950</span>
                    <span class="decade-label">Tarım Devrimi</span>
                </button>
                <button class="decade-btn" data-decade="1960">
                    <span class="decade-number">1960</span>
                    <span class="decade-label">Modernleşme</span>
                </button>
                <button class="decade-btn" data-decade="1970">
                    <span class="decade-number">1970</span>
                    <span class="decade-label">Sanayi Atılımı</span>
                </button>
                <button class="decade-btn" data-decade="1980">
                    <span class="decade-number">1980</span>
                    <span class="decade-label">Dönüşüm</span>
                </button>
                <button class="decade-btn" data-decade="1990">
                    <span class="decade-number">1990</span>
                    <span class="decade-label">Teknoloji</span>
                </button>
                <button class="decade-btn" data-decade="2000">
                    <span class="decade-number">2000</span>
                    <span class="decade-label">Globalleşme</span>
                </button>
                <button class="decade-btn" data-decade="2010">
                    <span class="decade-number">2010</span>
                    <span class="decade-label">İnovasyon</span>
                </button>
                <button class="decade-btn" data-decade="2020">
                    <span class="decade-number">2020</span>
                    <span class="decade-label">Gelecek</span>
                </button>


            </div>
        </div>
    </div>
</div>

<!-- Gallery Grid -->
<div class="gallery-container">
