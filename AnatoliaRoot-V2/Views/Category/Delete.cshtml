@model AnatoliaRoot_V2.Models.Category

@{
    ViewData["Title"] = "Kategori Sil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Kategori Silme Onayı
                    </h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <h5><i class="fas fa-warning"></i> Dikkat!</h5>
                        <p class="mb-0">Bu kategoriyi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz ve kategoriye bağlı tüm veriler silinecektir.</p>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-8">
                            <dl class="row">
                                <dt class="col-sm-4 fw-bold">ID:</dt>
                                <dd class="col-sm-8">@Model.Id</dd>
                                
                                <dt class="col-sm-4 fw-bold">Ad:</dt>
                                <dd class="col-sm-8">@Model.Name</dd>
                            </dl>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="delete-icon mb-3">
                                <i class="fas fa-trash-alt fa-4x text-danger"></i>
                            </div>
                            <p class="text-muted small">Bu kategori kalıcı olarak silinecektir.</p>
                        </div>
                    </div>
                    
                    <form id="deleteForm" asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left"></i> İptal
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg" id="deleteBtn">
                                <i class="fas fa-trash"></i> Evet, Sil
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="successModalLabel">
                    <i class="fas fa-check-circle"></i> Başarılı
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="successMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-bs-dismiss="modal" onclick="window.location.href='@Url.Action("Index")'">
                    <i class="fas fa-check"></i> Tamam
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Error Modal -->
<div class="modal fade" id="errorModal" tabindex="-1" aria-labelledby="errorModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="errorModalLabel">
                    <i class="fas fa-exclamation-triangle"></i> Hata
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="errorMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Kapat
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#deleteForm').on('submit', function(e) {
                e.preventDefault();
                
                // Butonu devre dışı bırak
                $('#deleteBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Siliniyor...');
                
                $.ajax({
                    url: '@Url.Action("Delete")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function(response) {
                        if (response.success) {
                            $('#successMessage').text(response.message);
                            $('#successModal').modal('show');
                        } else {
                            $('#errorMessage').text(response.message);
                            $('#errorModal').modal('show');
                        }
                    },
                    error: function() {
                        $('#errorMessage').text('Bir hata oluştu. Lütfen tekrar deneyiniz.');
                        $('#errorModal').modal('show');
                    },
                    complete: function() {
                        // Butonu tekrar aktif et
                        $('#deleteBtn').prop('disabled', false).html('<i class="fas fa-trash"></i> Evet, Sil');
                    }
                });
            });
        });
    </script>
} 