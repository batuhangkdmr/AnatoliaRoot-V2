@{
    ViewData["Title"] = "İthalat & İhracat Hizmetleri";
}

<style>
.trade-hero {
    background: linear-gradient(135deg, #d5ddd1 0%, #b1cfb1 100%);
    border-radius: 1.5rem;
    padding: 2.5rem 1rem 2rem 1rem;
    margin-bottom: 2.5rem;
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.37);
    text-align: center;
    position: relative;
    overflow: hidden;
}

.trade-section {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
    justify-content: center;
    margin-bottom: 3rem;
    flex-wrap: wrap;
}

.trade-card {
    background: #fff;
    border-radius: 1.2rem;
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.15);
    padding: 2rem 1.5rem 1.5rem 1.5rem;
    text-align: center;
    max-width: 400px;
    min-width: 280px;
    flex: 1 1 380px;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 auto;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.trade-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px 0 rgba(31, 38, 135, 0.25);
}

.trade-icon {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #b1cfb1 0%, #388e3c 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    font-size: 2rem;
    color: white;
    transition: all 0.3s ease;
    box-shadow: 0 8px 20px rgba(177, 207, 177, 0.3);
}

.trade-card:hover .trade-icon {
    transform: scale(1.1) rotate(5deg);
    box-shadow: 0 12px 25px rgba(177, 207, 177, 0.4);
}

.trade-card h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #123524;
    margin-bottom: 1rem;
    position: relative;
}

.trade-card p {
    font-size: 1rem;
    color: #555;
    line-height: 1.6;
    margin: 0 0 1rem 0;
    flex-grow: 1;
}

.trade-features {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    text-align: left;
    width: 100%;
}

.trade-features li {
    padding: 0.5rem 0;
    color: #666;
    font-size: 0.95rem;
    position: relative;
    padding-left: 1.5rem;
}

.trade-features li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #388e3c;
    font-weight: bold;
    font-size: 1.1rem;
}

.trade-form-box {
    background: #fff;
    border-radius: 1.2rem;
    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.10);
    padding: 2.5rem 2.2rem 2rem 2.2rem;
    max-width: 570px;
    min-width: 260px;
    flex: 1 1 520px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
}

.trade-form-box h4 {
    font-size: 1.15rem;
    font-weight: 700;
    color: #123524;
    margin-bottom: 1.1rem;
    text-align: center;
}

.trade-form label {
    font-size: 0.98rem;
    color: #333;
    margin-bottom: 0.2rem;
    font-weight: 500;
}

.trade-form input,
.trade-form textarea,
.trade-form select {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid #b1cfb1;
    border-radius: 0.6rem;
    margin-bottom: 1rem;
    font-size: 1rem;
    background: #f8faf8;
    transition: border 0.2s;
}

.trade-form input:focus,
.trade-form textarea:focus,
.trade-form select:focus {
    border-color: #5A827E;
    outline: none;
}

.trade-form button {
    background: linear-gradient(135deg, #b1cfb1 0%, #388e3c 100%);
    color: #fff;
    font-weight: 700;
    border: none;
    border-radius: 0.6rem;
    padding: 0.8rem 1.2rem;
    font-size: 1.08rem;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    width: 100%;
}

.trade-form button:hover {
    background: linear-gradient(135deg, #388e3c 0%, #b1cfb1 100%);
    color: #fff;
}

@@media (max-width: 991.98px) {
    .trade-section {
        flex-direction: column;
        gap: 1.5rem;
        align-items: stretch;
    }
    .trade-card, .trade-form-box {
        max-width: 100%;
        min-width: 0;
    }
    .trade-form-box {
        max-width: 100%;
        min-width: 0;
        padding: 2rem 1.5rem 1.5rem 1.5rem;
    }
}

@@media (max-width: 600px) {
    .trade-card {
        padding: 1.5rem 1rem 1rem 1rem;
    }
    .trade-icon {
        width: 60px;
        height: 60px;
        font-size: 1.5rem;
    }
    .trade-card h3 {
        font-size: 1.2rem;
    }
}
</style>

<div class="container py-4">
    <div class="trade-hero">
        <h1>İTHALAT & İHRACAT HİZMETLERİ</h1>
        <p>Uluslararası ticaret çözümleri ile işinizi global pazarlara taşıyoruz.</p>
    </div>
    
    <div class="trade-section">
        <!-- İthalat Kartı -->
        <div class="trade-card">
            <div class="trade-icon">
                <i class="fa fa-download"></i>
            </div>
            <h3>İthalat Hizmetleri</h3>
            <p>Güvenilir ithalat hizmetlerimizle işinizi büyütün. Deneyimli ekibimiz ve güçlü iş ortaklıklarımızla ithalat süreçlerinizi yönetiyoruz.</p>
            <ul class="trade-features">
                <li>Gümrük işlemleri</li>
                <li>Lojistik çözümler</li>
                <li>Belge yönetimi</li>
                <li>Kalite kontrol</li>
                <li>Risk yönetimi</li>
            </ul>
        </div>

        <!-- İhracat Kartı -->
        <div class="trade-card">
            <div class="trade-icon">
                <i class="fa fa-upload"></i>
            </div>
            <h3>İhracat Hizmetleri</h3>
            <p>Tokat'ın değerlerini dünya pazarlarına taşıyoruz. Profesyonel ihracat hizmetlerimizle ürünlerinizi global pazarlarda konumlandırıyoruz.</p>
            <ul class="trade-features">
                <li>Pazar araştırması</li>
                <li>Müşteri bulma</li>
                <li>Belge hazırlama</li>
                <li>Nakliye organizasyonu</li>
                <li>Satış sonrası destek</li>
            </ul>
        </div>

        <!-- Talep Formu -->
        <div class="trade-form-box">
            <h4>İthalat/İhracat Talep Formu</h4>
            <form class="trade-form" action="https://formspree.io/f/xldlrpza" method="POST" id="tradeForm">
                <label for="adSoyad">Adınız Soyadınız</label>
                <input type="text" id="adSoyad" name="adSoyad" required placeholder="Adınızı giriniz">
                
                <label for="eposta">E-posta</label>
                <input type="email" id="eposta" name="eposta" required placeholder="E-posta adresiniz">
                
                <label for="hizmetTipi">Hizmet Tipi</label>
                <select id="hizmetTipi" name="hizmetTipi" required>
                    <option value="">Hizmet seçiniz</option>
                    <option value="İthalat">İthalat Hizmeti</option>
                    <option value="İhracat">İhracat Hizmeti</option>
                    <option value="Her İkisi">Her İkisi</option>
                </select>
                
                <label for="urunDetay">Ürün/Hizmet Detayları</label>
                <textarea id="urunDetay" name="urunDetay" rows="4" required placeholder="İthalat/ihracat yapmak istediğiniz ürün veya hizmet hakkında detay veriniz..."></textarea>
                
                <div class="form-check mb-2" style="text-align:left; display:flex; align-items:center; gap:0.5rem;">
                    <input class="form-check-input" type="checkbox" id="kvkkAydinlatma" name="kvkkAydinlatma" required style="width:16px; height:16px; margin:0;">
                    <label class="form-check-label" for="kvkkAydinlatma" style="font-size:0.95rem; margin:0; display:flex; align-items:center; gap:0.3rem;">
                        <a href="#" id="kvkkModalLink">KVKK Aydınlatma Metni</a>'ni okudum, anladım ve kabul ediyorum.
                    </label>
                </div>
                <div class="form-check mb-3" style="text-align:left; display:flex; align-items:center; gap:0.5rem;">
                    <input class="form-check-input" type="checkbox" id="kvkkRiza" name="kvkkRiza" required style="width:16px; height:16px; margin:0;">
                    <label class="form-check-label" for="kvkkRiza" style="font-size:0.95rem; margin:0; display:flex; align-items:center; gap:0.3rem;">
                        <a href="#" id="kvkkRizaModalLink">KVKK Açık Rıza Metni</a>'ni okudum, anladım ve kabul ediyorum.
                    </label>
                </div>
                
                <button type="submit">Talep Gönder</button>
            </form>
        </div>
    </div>
</div>

<!-- Bootstrap Modal KVKK Aydınlatma -->
<div class="modal fade" id="kvkkAydinlatmaModal" tabindex="-1" aria-labelledby="kvkkAydinlatmaModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="kvkkAydinlatmaModalLabel">Kişisel Verilerin Korunması Aydınlatma Metni</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
      </div>
      <div class="modal-body" style="font-size:1rem; color:#222;">
        <p>Bu aydınlatma metni, 6698 sayılı Kişisel Verilerin Korunması Kanunu ("KVKK") kapsamında, <b>AnatoliaRoot</b> olarak tarafımıza ilettiğiniz kişisel verilerinizin işlenme amaçları, hukuki sebepleri, toplanma yöntemi, kimlere ve hangi amaçla aktarılabileceği ve KVKK kapsamındaki haklarınız hakkında sizi bilgilendirmek amacıyla hazırlanmıştır.</p>
        <h6 class="mt-3">1. Kişisel Verilerin İşlenme Amacı</h6>
        <p>İthalat/İhracat talep formu aracılığıyla paylaştığınız ad, soyad, e-posta adresi, hizmet tipi ve ürün detayları bilgileriniz; yalnızca talebinizin değerlendirilmesi, size geri dönüş yapılması ve hizmetlerimizin geliştirilmesi amacıyla işlenmektedir.</p>
        <p><strong>Zorunlu Kişisel Veriler:</strong> Ad Soyad, e-posta adresi, hizmet tipi ve ürün detayları alanları ithalat/ihracat hizmeti verebilmek için zorunludur. Bu bilgiler olmadan talebinizi değerlendiremeyiz. Kişisel verileriniz hiçbir şekilde üçüncü kişilerle paylaşılmaz, ticari amaçla kullanılmaz.</p>
        <h6 class="mt-3">2. Kişisel Verilerin Toplanma Yöntemi ve Hukuki Sebebi</h6>
        <p>Kişisel verileriniz, web sitemizdeki ithalat/ihracat talep formu aracılığıyla elektronik ortamda, tamamen sizin açık rızanız ile toplanmaktadır. Bu veriler, KVKK md. 5/1-a kapsamında "açık rızanızın bulunması" hukuki sebebine dayanmaktadır.</p>
        <h6 class="mt-3">3. Kişisel Verilerin Aktarılması</h6>
        <p>Kişisel verileriniz, yasal yükümlülükler haricinde hiçbir şekilde üçüncü şahıslarla paylaşılmaz ve yurt dışına aktarılmaz.</p>
        <h6 class="mt-3">4. Kişisel Verilerin Saklanma Süresi</h6>
        <p>İthalat/İhracat talep formu ile paylaşılan kişisel veriler, 3 yıl süreyle saklanır ve bu sürenin sonunda güvenli şekilde silinir.</p>
        <h6 class="mt-3">5. KVKK Kapsamındaki Haklarınız</h6>
        <p>KVKK md. 11 uyarınca sahip olduğunuz haklar:</p>
        <ul>
          <li>Kişisel verilerinizin işlenip işlenmediğini öğrenme</li>
          <li>Kişisel verileriniz işlenmişse buna ilişkin bilgi talep etme</li>
          <li>Kişisel verilerinizin işlenme amacını ve bunların amacına uygun kullanılıp kullanılmadığını öğrenme</li>
          <li>Yurt içinde veya yurt dışında kişisel verilerinizin aktarıldığı üçüncü kişileri bilme</li>
          <li>Kişisel verilerinizin eksik veya yanlış işlenmiş olması hâlinde bunların düzeltilmesini isteme</li>
          <li>KVKK'nın 7. maddesinde öngörülen şartlar çerçevesinde kişisel verilerinizin silinmesini veya yok edilmesini isteme</li>
        </ul>
        <h6 class="mt-3">6. İletişim</h6>
        <p>KVKK kapsamındaki haklarınızı kullanmak veya kişisel verilerinizle ilgili her türlü soru ve talepleriniz için <a href="mailto:info@anatoliaroot.com">info@anatoliaroot.com</a> adresine e-posta gönderebilirsiniz.</p>
        <hr />
        <p style="font-size:0.98rem; color:#555;">Bu metin, <b>AnatoliaRoot</b> tarafından güncellenebilir. Lütfen düzenli olarak kontrol ediniz.</p>
      </div>
    </div>
  </div>
</div>

<!-- Bootstrap Modal KVKK Açık Rıza -->
<div class="modal fade" id="kvkkRizaModal" tabindex="-1" aria-labelledby="kvkkRizaModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="kvkkRizaModalLabel">KVKK Açık Rıza Metni</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
      </div>
      <div class="modal-body" style="font-size:1rem; color:#222;">
        <p>6698 sayılı Kişisel Verilerin Korunması Kanunu (KVKK) md. 5/1-a kapsamında, ithalat/ihracat talep formu aracılığıyla paylaştığım kişisel verilerimin yukarıda belirtilen aydınlatma metni doğrultusunda toplanmasına, işlenmesine ve belirtilen amaçlarla kullanılmasına bilinçli ve açık rızamla izin veriyorum.</p>
      </div>
    </div>
  </div>
</div>

<!-- Bootstrap 5 Modal JS (CDN) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- SweetAlert2 CDN -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.getElementById('tradeForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    var kvkkAydinlatma = document.getElementById('kvkkAydinlatma');
    var kvkkRiza = document.getElementById('kvkkRiza');
    if (!kvkkAydinlatma.checked || !kvkkRiza.checked) {
        Swal.fire({
            icon: 'warning',
            title: 'Uyarı',
            text: 'Formu gönderebilmek için her iki KVKK onay kutusunu da işaretlemelisiniz.'
        });
        return;
    }
    // Form verilerini topla
    const formData = new FormData(tradeForm);
    
    // Form source bilgisi ekle
    formData.append('formSource', 'İthalat/İhracat Formu - Trade Sayfası');
    
    try {
        const response = await fetch(tradeForm.action, {
            method: 'POST',
            body: formData,
            headers: { 'Accept': 'application/json' }
        });
        if (response.ok) {
            Swal.fire({
                icon: 'success',
                title: 'Başarılı!',
                text: 'İthalat/İhracat talebiniz başarıyla gönderildi. En kısa sürede sizinle iletişime geçeceğiz.',
                confirmButtonText: 'Tamam'
            });
            tradeForm.reset();
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Hata',
                text: 'Bir hata oluştu, lütfen tekrar deneyin.'
            });
        }
    } catch (err) {
        Swal.fire({
            icon: 'error',
            title: 'Hata',
            text: 'Bir hata oluştu, lütfen tekrar deneyin.'
        });
    }
});

document.getElementById('kvkkModalLink').addEventListener('click', function(e) {
    e.preventDefault();
    var modal = new bootstrap.Modal(document.getElementById('kvkkAydinlatmaModal'));
    modal.show();
});

document.getElementById('kvkkRizaModalLink').addEventListener('click', function(e) {
    e.preventDefault();
    var modal = new bootstrap.Modal(document.getElementById('kvkkRizaModal'));
    modal.show();
});
</script> 