@model AnatoliaRoot_V2.Models.Category

@{
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h3 class="card-title mb-0">
                        <i class="fas fa-edit"></i> Kategori Düzenle
                    </h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold">
                                <i class="fas fa-tag"></i> Kategori Adı *
                            </label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="Kategori adını giriniz" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        @if (Model.ParentCategoryId == null)
                        {
                            <!-- Ana kategori - sadece ad değiştirilebilir -->
                            <div class="mb-4">
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle"></i> Bu bir ana kategoridir. Sadece kategori adını değiştirebilirsiniz.
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Alt kategori - üst kategori seçimi yapılabilir -->
                            <div class="mb-4">
                                <label for="ParentCategoryId" class="form-label fw-bold">
                                    <i class="fas fa-sitemap"></i> Üst Kategori
                                </label>
                                <select name="ParentCategoryId" id="ParentCategoryId" class="form-select form-select-lg">
                                    <option value="">Ana Kategori (Üst kategori yok)</option>
                                    @if (ViewBag.ParentCategories != null)
                                    {
                                        foreach (var parentCategory in ViewBag.ParentCategories)
                                        {
                                            if (Model.ParentCategoryId == parentCategory.Id)
                                            {
                                                <option value="@parentCategory.Id" selected>@parentCategory.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@parentCategory.Id">@parentCategory.Name</option>
                                            }
                                        }
                                    }
                                </select>
                                <small class="form-text text-muted">
                                    Bu kategoriyi bir üst kategoriye bağlamak istiyorsanız seçiniz. Boş bırakırsanız ana kategori olur.
                                </small>
                            </div>
                        }
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <a asp-action="Index" class="btn btn-secondary btn-lg">
                                <i class="fas fa-arrow-left"></i> Geri Dön
                            </a>
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="fas fa-save"></i> Güncelle
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
} 