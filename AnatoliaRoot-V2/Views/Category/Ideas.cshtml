@{
    ViewData["Title"] = "Fikir Yönetimi & Proje Danışmanlığı";
}

<div class="innovation-master-container">
    <div class="innovation-split-wrapper">
        <div class="master-content-side">
            <div class="sticky-content-wrapper p-lg-5 p-4">
                <h1 class="main-display-title animate__animated animate__fadeInUp">
                    Doğru Stratejiyle <br />
                    <span class="accent-color">Fikrinizi Yönetiyoruz.</span>
                </h1>

                <p class="master-lead-text animate__animated animate__fadeInUp animate__delay-1s">
                    Sermaye gücüyle vizyoner projeleri bir araya getiren profesyonel bir ekosistem kuruyoruz. Fikirlerinizi kağıt üzerinden alıp, sürdürülebilir ve ölçeklenebilir iş modellerine dönüştürüyoruz.
                </p>

                <div class="seo-feature-grid mt-5">
                    <div class="seo-feature-item animate__animated animate__fadeInLeft animate__delay-2s">
                        <div class="feature-icon"><i class="fa fa-lightbulb-o"></i></div>
                        <div class="feature-text">
                            <h5>Fikir ve Proje Geliştirme</h5>
                            <p>Yenilikçi fikirlerin pazar analizini yapıyor, en verimli iş modellerini kurguluyoruz.</p>
                        </div>
                    </div>

                    <div class="seo-feature-item animate__animated animate__fadeInLeft animate__delay-3s">
                        <div class="feature-icon"><i class="fa fa-handshake-o"></i></div>
                        <div class="feature-text">
                            <h5>Yatırım ve Sermaye Yönetimi</h5>
                            <p>Doğru yatırımı doğru projeye yönlendirerek güvenli bir büyüme zemini hazırlıyoruz.</p>
                        </div>
                    </div>

                    <div class="seo-feature-item animate__animated animate__fadeInLeft animate__delay-4s">
                        <div class="feature-icon"><i class="fa fa-line-chart"></i></div>
                        <div class="feature-text">
                            <h5>Operasyonel Rehberlik</h5>
                            <p>Hukuki, mali ve yönetimsel süreçlerde uçtan uca danışmanlık sağlıyoruz.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="master-form-side">
            <div class="form-container-inner p-lg-5 p-3 animate__animated animate__fadeInRight">
                <div class="form-card-box shadow-lg border-0">
                    <div class="form-header-badge">BAŞVURU MERKEZİ</div>
                    <h2 class="fw-bold mb-4">Bir Adım Atın</h2>

                    <form id="masterInnovationForm" action="https://formspree.io/f/xldlrpza" method="POST" autocomplete="off">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="custom-field">
                                    <label>Ad Soyad / Firma</label>
                                    <input type="text" name="Ad_Soyad_Firma" required placeholder="Girişimci veya Kurum Adı">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="custom-field">
                                    <label>E-Posta</label>
                                    <input type="email" name="Email_Adresi" required placeholder="Mail adresiniz">
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="custom-field">
                                    <label>Rolünüz</label>
                                    <select name="Basvuru_Yapan_Rolu" required class="form-select custom-select-ui">
                                        <option value="" disabled selected>Lütfen Seçiniz</option>
                                        <option value="Fikir Sahibi">Fikrim Var, Yönetim Desteği İstiyorum</option>
                                        <option value="Yatirimci">Maddiyatım Var, Doğru Proje Arıyorum</option>
                                        <option value="Ortaklik">İş Ortağı / Danışmanlık Adayıyım</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="custom-field">
                                    <label>Fikir/Proje Başlığı</label>
                                    <input type="text" name="Proje_Basligi" required placeholder="Kısa bir başlık yazın">
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="custom-field">
                                    <label>Detaylı Açıklama</label>
                                    <textarea name="Mesaj_Detayi" rows="4" required placeholder="Size nasıl yardımcı olabiliriz? Lütfen detaylandırın..."></textarea>
                                </div>
                            </div>

                            <div class="col-12">
                                <div class="kvkk-box-wrapper mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="kvkkOkundu" name="KVKK_Aydinlatma_Onayi" value="Onaylandi" required>
                                        <label class="form-check-label small lh-sm" for="kvkkOkundu">
                                            <a href="#" class="text-success fw-bold" data-bs-toggle="modal" data-bs-target="#kvkkModal">KVKK Aydınlatma Metni</a>'ni okudum.
                                        </label>
                                    </div>
                                    <div class="form-check mt-2">
                                        <input class="form-check-input" type="checkbox" id="kvkkRizaOkundu" name="KVKK_Acik_Riza_Onayi" value="Onaylandi" required>
                                        <label class="form-check-label small lh-sm" for="kvkkRizaOkundu">
                                            <a href="#" class="text-success fw-bold" data-bs-toggle="modal" data-bs-target="#kvkkRizaModal">KVKK Açık Rıza Metni</a>'ni onaylıyorum.
                                        </label>
                                    </div>
                                </div>
                                <button type="submit" class="master-submit-btn">
                                    <span>BAŞVURUYU TAMAMLA</span>
                                    <i class="fa fa-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="seo-blog-marquee-section py-5">
        <div class="container-fluid">
            <h3 class="text-center fw-bold mb-5" style="color: #123524;">Stratejik Proje Yönetimi Blogları</h3>
            <div class="marquee-wrapper">
                <div class="marquee-content">
                    <div class="blog-card-mini shadow-sm">
                        <div class="blog-badge-small">YÖNETİM</div>
                        <h6>Fizibilite Analizi</h6>
                        <p>İş fikirlerinin pazar karşılığını analiz ederek riskleri minimize eden yönetim planları hazırlıyoruz.</p>
                    </div>
                    <div class="blog-card-mini shadow-sm highlight">
                        <div class="blog-badge-small">YATIRIM</div>
                        <h6>Sermaye Danışmanlığı</h6>
                        <p>Yatırımcılar için şeffaf raporlama ve güvenli proje yönetim süreçleri ile sermayeyi koruyoruz.</p>
                    </div>
                    <div class="blog-card-mini shadow-sm">
                        <div class="blog-badge-small">GİRİŞİMCİLİK</div>
                        <h6>Ölçeklenebilir Modeller</h6>
                        <p>Fikirlerin sadece kurulmasını değil, yıllarca büyümesini sağlayacak iş modelleri geliştiriyoruz.</p>
                    </div>
                    <div class="blog-card-mini shadow-sm highlight">
                        <div class="blog-badge-small">HUKUK</div>
                        <h6>Gizlilik ve NDA</h6>
                        <p>Proje paylaşımlarında fikir mülkiyeti haklarını KVKK standartlarında güvence altına alıyoruz.</p>
                    </div>
                    <div class="blog-card-mini shadow-sm">
                        <div class="blog-badge-small">PAZARLAMA</div>
                        <h6>Pazar Giriş Stratejisi</h6>
                        <p>İnovatif ürünlerin doğru kitleye ulaşması için operasyonel pazarlama planları sunuyoruz.</p>
                    </div>
                    <div class="blog-card-mini shadow-sm highlight">
                        <div class="blog-badge-small">OPERASYON</div>
                        <h6>Uçtan Uca İcraat</h6>
                        <p>Projenin hayata geçme aşamasındaki lojistik ve operasyonel süreçleri ekibimizle yönetiyoruz.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="kvkkModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">KVKK Aydınlatma Metni</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" style="font-size:0.95rem; color:#333; line-height:1.6;">
                <p><strong>Veri Sorumlusu:</strong> AnatoliaRoot ("Şirket")</p>
                <p>Bu Aydınlatma Metni, 6698 sayılı Kişisel Verilerin Korunması Kanunu’nun (“Kanun”) 10. maddesi çerçevesinde, web sitemizdeki formlar aracılığıyla toplanan kişisel verilerinizin işlenmesine yönelik yöntem, amaç ve haklarınız hakkında sizi bilgilendirmek amacıyla hazırlanmıştır.</p>

                <h6 class="fw-bold mt-3">1. İşlenen Kişisel Verileriniz ve Toplama Yöntemi</h6>
                <p>İlgili formlar üzerinden paylaştığınız; ad-soyad, e-posta adresi, telefon numarası, konum ve mesaj içeriğine dair verileriniz; tamamen sizin özgür iradenizle doldurduğunuz formlar aracılığıyla elektronik ortamda toplanmaktadır.</p>

                <h6 class="fw-bold mt-3">2. Veri İşleme Amaçları ve Hukuki Sebepler</h6>
                <p>Kişisel verileriniz, Kanun’un 5. maddesinde belirtilen şu hukuki sebeplerle işlenmektedir:</p>
                <ul>
                    <li><strong>Sözleşmenin Kurulması veya İfası:</strong> Talebinize yönelik teklif hazırlanması ve hizmet sunumu için zorunlu olması.</li>
                    <li><strong>Veri Sorumlusunun Meşru Menfaati:</strong> Size geri dönüş yapılması ve müşteri ilişkileri yönetimi süreçlerinin yürütülmesi.</li>
                    <li><strong>Açık Rıza:</strong> Pazarlama veya bilgilendirme süreçlerine onay vermeniz durumunda.</li>
                </ul>

                <h6 class="fw-bold mt-3">3. Verilerin Kimlere ve Hangi Amaçla Aktarılabileceği</h6>
                <p>Kişisel verileriniz; üçüncü şahıslara veya kurumlara ticari amaçla <u>aktarılmamaktadır</u>. Sadece yasal yükümlülüklerin yerine getirilmesi amacıyla yetkili kamu kurum ve kuruluşları ile talep halinde paylaşılabilir.</p>

                <h6 class="fw-bold mt-3">4. Kanun’un 11. Maddesi Kapsamındaki Haklarınız</h6>
                <p>Şirketimize başvurarak verilerinizle ilgili şu haklara sahipsiniz:</p>
                <ul>
                    <li>Kişisel verinizin işlenip işlenmediğini öğrenme,</li>
                    <li>Verileriniz işlenmişse buna ilişkin bilgi talep etme,</li>
                    <li>Verilerin işlenme amacına uygun kullanılıp kullanılmadığını öğrenme,</li>
                    <li>Eksik veya yanlış işlenmişse düzeltilmesini isteme,</li>
                    <li>Kanun çerçevesinde verilerin silinmesini veya yok edilmesini isteme.</li>
                </ul>
                <p>Taleplerinizi <strong>info@anatoliaroot.com</strong> adresine iletebilirsiniz.</p>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="kvkkRizaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">KVKK Açık Rıza Metni</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body" style="font-size:1rem; color:#222; line-height:1.6;">
                <p>6698 sayılı Kişisel Verilerin Korunması Kanunu uyarınca, AnatoliaRoot tarafından sunulan Aydınlatma Metni'ni okuduğumu ve anladığımı kabul ederim.</p>
                <p>Bu kapsamda;</p>
                <ul>
                    <li>Kimlik ve iletişim verilerimin; ürün/hizmet taleplerimin karşılanması, tekliflerin hazırlanması ve süreç hakkında tarafımla iletişim kurulması amacıyla işlenmesine,</li>
                    <li>Gerektiğinde talebimin sonuçlandırılması adına hizmet sağlayıcılar ve yasal mercilerle sınırlı olarak paylaşılmasına,</li>
                </ul>
                <p>Hiçbir baskı altında kalmadan, bilgilendirilmiş olarak <strong>açık rızam ile onay veriyorum.</strong></p>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --main-dark: #123524;
        --main-green: #388e3c;
        --soft-green: #b1cfb1;
        --bg-white: #ffffff;
    }

    .innovation-master-container {
        width: 100%;
        overflow-x: hidden;
        background: #fdfdfd;
    }

    .innovation-split-wrapper {
        display: flex;
        min-height: 85vh;
    }

    .master-content-side {
        flex: 1.2;
        background: linear-gradient(135deg, #f8faf8 0%, #eaf2ea 100%);
    }

    .main-display-title {
        font-size: 3.5rem;
        font-weight: 900;
        color: var(--main-dark);
        line-height: 1.2;
        margin-bottom: 1.5rem;
    }

    .accent-color {
        color: var(--main-green);
    }

    .brand-badge {
        display: inline-block;
        padding: 6px 15px;
        background: var(--soft-green);
        color: var(--main-dark);
        border-radius: 5px;
        font-weight: 800;
        font-size: 0.75rem;
        letter-spacing: 2px;
        margin-bottom: 2rem;
    }

    .master-lead-text {
        font-size: 1.1rem;
        color: #444;
        line-height: 1.8;
        max-width: 600px;
    }

    .master-form-side {
        flex: 1;
        background: var(--bg-white);
        border-left: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-card-box {
        background: #fff;
        padding: 2.5rem;
        border-radius: 25px;
        width: 100%;
        max-width: 550px;
        position: relative;
        border: 1px solid #f0f0f0;
    }

    .form-header-badge {
        position: absolute;
        top: -15px;
        right: 30px;
        background: var(--main-dark);
        color: #fff;
        padding: 5px 20px;
        border-radius: 50px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    /* Form & Mobile Fix */
    .custom-field {
        margin-bottom: 1rem;
        width: 100%;
        box-sizing: border-box;
    }

        .custom-field label {
            font-weight: 700;
            font-size: 0.85rem;
            color: var(--main-dark);
            margin-bottom: 5px;
            display: block;
        }

        .custom-field input, .custom-field textarea, .custom-select-ui {
            width: 100% !important;
            box-sizing: border-box !important;
            border: 2px solid #f5f5f5;
            border-radius: 12px;
            padding: 12px 15px;
            background: #fafafa;
            transition: all 0.3s ease;
            color: #333;
        }

            .custom-field input:focus, .custom-select-ui:focus {
                border-color: var(--main-green);
                outline: none;
                background: #fff;
                box-shadow: 0 0 0 4px rgba(56,142,60,0.1);
            }

    .master-submit-btn {
        width: 100%;
        padding: 18px;
        background: var(--main-dark);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-weight: 800;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.4s ease;
        cursor: pointer;
    }

        .master-submit-btn:hover {
            background: var(--main-green) !important;
            transform: translateY(-3px);
            color: #fff !important;
            box-shadow: 0 10px 20px rgba(56, 142, 60, 0.2);
        }

    /* Blog Marquee */
    .marquee-wrapper {
        width: 100%;
        overflow: hidden;
        padding: 30px 0;
    }

    .marquee-content {
        display: flex;
        gap: 30px;
        animation: scrollMarquee 45s linear infinite;
        width: max-content;
    }

    .marquee-wrapper:hover .marquee-content {
        animation-play-state: paused;
    }

    .blog-card-mini {
        width: 320px;
        background: #fff;
        padding: 30px;
        border-radius: 20px;
        border-bottom: 4px solid var(--soft-green);
        transition: 0.3s ease;
    }

        .blog-card-mini.highlight {
            border-bottom-color: var(--main-green);
            background: #f9fbf9;
        }

        .blog-card-mini:hover {
            transform: translateY(-10px);
        }

    .blog-badge-small {
        font-size: 1.65rem;
        font-weight: 900;
        color: var(--main-green);
        letter-spacing: 1.5px;
    }

    .seo-feature-grid {
        display: grid;
        gap: 25px;
    }

    .seo-feature-item {
        display: flex;
        gap: 20px;
    }

    .feature-icon {
        min-width: 50px;
        height: 50px;
        background: #fff;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--main-green);
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }

    @@keyframes scrollMarquee {
        0% {
            transform: translateX(0);
        }

        100% {
            transform: translateX(-50%);
        }
    }

    @@media (max-width: 1100px) {
        .innovation-split-wrapper {
            flex-direction: column;
        }

        .master-form-side {
            border-left: none;
            padding-bottom: 40px;
        }

        .form-card-box {
            border-radius: 0;
            padding: 2rem 1.5rem;
            border: none;
        }

        .main-display-title {
            font-size: 2.2rem;
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.getElementById('masterInnovationForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        const btn = this.querySelector('.master-submit-btn span');
        const icon = this.querySelector('.master-submit-btn i');
        const originalText = btn.innerText;

        btn.innerText = "İŞLENİYOR...";
        icon.className = "fa fa-spinner fa-spin";

        const formData = new FormData(this);
        formData.append('formSource', 'Fikir ve Proje Portalı');

        try {
            const response = await fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: { 'Accept': 'application/json' }
            });
            if (response.ok) {
                Swal.fire({ icon: 'success', title: 'Başarılı!', text: 'Proje detaylarınız ekibimize iletildi.', confirmButtonColor: '#388e3c' });
                this.reset();
            } else { throw new Error(); }
        } catch (error) {
            Swal.fire({ icon: 'error', title: 'Hata', text: 'Gönderim yapılamadı. Lütfen tekrar deneyiniz.', confirmButtonColor: '#123524' });
        } finally {
            btn.innerText = originalText;
            icon.className = "fa fa-arrow-right";
        }
    });
</script>