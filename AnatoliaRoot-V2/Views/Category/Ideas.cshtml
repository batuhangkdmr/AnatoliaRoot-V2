@{
    ViewData["Title"] = "Fikirler ve Projeler";
}

<!-- Hero Section -->
<div class="ideas-hero">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-10">
                <div class="hero-content animate__animated animate__fadeInUp">
                    <div class="hero-icon">
                        <div class="idea-lightbulb">
                            <i class="fa fa-lightbulb-o"></i>
                            <div class="light-rays"></div>
                        </div>
                    </div>
                    <h1 class="hero-title">Fikirlerinle Geleceği Şekillendir!</h1>
                    <p class="hero-subtitle">Yaratıcı düşüncelerini, projelerini veya ihtiyaçlarını bizimle paylaş. Her fikir, geleceğe atılan bir adımdır.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Page Purpose Section -->
<div class="ideas-purpose">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="purpose-card animate__animated animate__fadeInUp" data-wow-delay="0.2s">
                    <div class="purpose-icon">
                        <div class="brain-creativity">
                            <i class="fa fa-brain"></i>
                            <div class="thought-bubbles">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                    </div>
                    <h3>Bu Alan Neden Var?</h3>
                    <p>Bu alan, topluluğumuzun veya iş ortaklarımızın yaratıcı fikirlerini, ihtiyaçlarını ve projelerini güvenle paylaşabilmesi için oluşturulmuştur. Paylaştığınız her fikir sadece yönetici ekibimize ulaşır, gizlilikle değerlendirilir ve size geri dönüş yapılır.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- How It Works Section -->
<div class="how-it-works">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-10">
                <h2 class="section-title animate__animated animate__fadeInUp">Nasıl Çalışır?</h2>
                <div class="steps-container">
                    <div class="step-item animate__animated animate__fadeInUp" data-wow-delay="0.1s">
                        <div class="step-icon">
                            <div class="step-idea-share">
                                <i class="fa fa-share-alt"></i>
                            </div>
                        </div>
                        <h4>1. Fikrini Paylaş</h4>
                        <p>Formu doldurarak fikrini veya ihtiyacını bizimle paylaş</p>
                    </div>
                    <div class="step-item animate__animated animate__fadeInUp" data-wow-delay="0.2s">
                        <div class="step-icon">
                            <div class="step-review">
                                <i class="fa fa-search"></i>
                            </div>
                        </div>
                        <h4>2. İnceleme</h4>
                        <p>Yöneticilerimiz fikrini detaylı olarak inceler</p>
                    </div>
                    <div class="step-item animate__animated animate__fadeInUp" data-wow-delay="0.3s">
                        <div class="step-icon">
                            <div class="step-feedback">
                                <i class="fa fa-comments"></i>
                            </div>
                        </div>
                        <h4>3. Geri Dönüş</h4>
                        <p>Gerekirse sana detaylı geri dönüş yapılır</p>
                    </div>
                    <div class="step-item animate__animated animate__fadeInUp" data-wow-delay="0.4s">
                        <div class="step-icon">
                            <div class="step-privacy">
                                <i class="fa fa-shield"></i>
                            </div>
                        </div>
                        <h4>4. Gizlilik</h4>
                        <p>Tüm süreç KVKK kapsamında gizli tutulur</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Why Share Ideas Section -->
<div class="why-share">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="why-share-content animate__animated animate__fadeInUp">
                    <h3>Neden Fikir Paylaşmalısın?</h3>
                    <div class="benefits-grid">
                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <i class="fa fa-lightbulb-o"></i>
                            </div>
                            <h5>Her Fikir Değerlidir</h5>
                            <p>Her fikir, yeni bir fırsat demektir ve geleceğe katkı sağlar.</p>
                        </div>
                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <i class="fa fa-users"></i>
                            </div>
                            <h5>Birlikte Çözüm Üretelim</h5>
                            <p>İhtiyaçlarını veya projelerini paylaşarak, birlikte çözüm üretebiliriz.</p>
                        </div>
                        <div class="benefit-item">
                            <div class="benefit-icon">
                                <i class="fa fa-shield"></i>
                            </div>
                            <h5>Gizliliğinize Önem Veriyoruz</h5>
                            <p>Verileriniz asla üçüncü kişilerle paylaşılmaz, tamamen gizli tutulur.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Idea Submission Form -->
<div class="ideas-form-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="ideas-form-box animate__animated animate__fadeInUp">
                    <div class="form-header">
                        <div class="form-icon">
                            <i class="fa fa-paper-plane"></i>
                        </div>
                        <h3>Fikir Paylaşım Formu</h3>
                        <p>Fikrinizi güvenle paylaşın, sadece yönetici ekibimize ulaşacak.</p>
                    </div>
                    
                    <form class="ideas-form" id="ideasForm" action="https://formspree.io/f/xldlrpza" method="POST">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="adSoyad">Ad Soyad (İsteğe bağlı)</label>
                                <input type="text" id="adSoyad" name="adSoyad" placeholder="Adınızı giriniz">
                            </div>
                            <div class="form-group">
                                <label for="eposta">E-posta (İsteğe bağlı)</label>
                                <input type="email" id="eposta" name="eposta" placeholder="E-posta adresiniz">
                            </div>
                        </div>
                        
                        <div class="form-group">
                            <label for="fikirBasligi">Fikir Başlığı *</label>
                            <input type="text" id="fikirBasligi" name="fikirBasligi" required placeholder="Fikrinizin başlığını yazın">
                        </div>
                        
                        <div class="form-group">
                            <label for="konu">Hangi Konuda? *</label>
                            <select id="konu" name="konu" required>
                                <option value="">Konu seçiniz</option>
                                <option value="teknoloji">Teknoloji</option>
                                <option value="egitim">Eğitim</option>
                                <option value="saglik">Sağlık</option>
                                <option value="cevre">Çevre</option>
                                <option value="ekonomi">Ekonomi</option>
                                <option value="sosyal">Sosyal Projeler</option>
                                <option value="diger">Diğer</option>
                            </select>
                        </div>
                        
                        <div class="form-group">
                            <label for="fikirAciklamasi">Fikir Açıklaması *</label>
                            <textarea id="fikirAciklamasi" name="fikirAciklamasi" rows="6" required 
                                      placeholder="Fikrinizi detaylı bir şekilde açıklayın..."></textarea>
                        </div>
                        
                        <div class="form-group">
                            <label>Çözüm önerisi bekliyor musunuz? *</label>
                            <div class="radio-group">
                                <label class="radio-item">
                                    <input type="radio" name="cozumOnerisi" value="evet" required>
                                    <span class="radio-custom"></span>
                                    Evet, çözüm önerisi bekliyorum
                                </label>
                                <label class="radio-item">
                                    <input type="radio" name="cozumOnerisi" value="hayir" required>
                                    <span class="radio-custom"></span>
                                    Hayır, sadece fikrimi paylaşmak istiyorum
                                </label>
                            </div>
                        </div>
                        
                        <div class="kvkk-section">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="kvkkAydinlatma" name="kvkkAydinlatma" required>
                                <label class="form-check-label" for="kvkkAydinlatma">
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#kvkkModal">KVKK Aydınlatma Metni</a>'ni okudum, anladım ve kabul ediyorum. *
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="kvkkRiza" name="kvkkRiza" required>
                                <label class="form-check-label" for="kvkkRiza">
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#kvkkRizaModal">KVKK Açık Rıza Metni</a>'ni okudum, anladım ve kabul ediyorum. *
                                </label>
                            </div>
                        </div>
                        
                        <button type="submit" class="submit-btn">
                            <span>Fikrimi Gönder</span>
                            <i class="fa fa-send"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FAQ Section -->
<div class="faq-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h2 class="section-title text-center animate__animated animate__fadeInUp">Sıkça Sorulan Sorular</h2>
                <div class="faq-container">
                    <div class="faq-item animate__animated animate__fadeInUp" data-wow-delay="0.1s">
                        <div class="faq-question" data-bs-toggle="collapse" data-bs-target="#faq1">
                            <h5>Fikrim neden herkese açık değil?</h5>
                            <i class="fa fa-chevron-down"></i>
                        </div>
                        <div id="faq1" class="collapse faq-answer">
                            <p>Fikirlerinizin gizliliğini korumak için tüm başvurular sadece yönetici ekibimize iletilir. Bu sayede fikriniz güvende kalır ve sadece gerekli kişiler tarafından değerlendirilir.</p>
                        </div>
                    </div>
                    
                    <div class="faq-item animate__animated animate__fadeInUp" data-wow-delay="0.2s">
                        <div class="faq-question" data-bs-toggle="collapse" data-bs-target="#faq2">
                            <h5>Ne kadar sürede dönüş alırım?</h5>
                            <i class="fa fa-chevron-down"></i>
                        </div>
                        <div id="faq2" class="collapse faq-answer">
                            <p>Fikriniz incelendikten sonra, gerekli görülürse en kısa sürede size geri dönüş yapılır. Genellikle 1-3 iş günü içerisinde değerlendirme tamamlanır.</p>
                        </div>
                    </div>
                    
                    <div class="faq-item animate__animated animate__fadeInUp" data-wow-delay="0.3s">
                        <div class="faq-question" data-bs-toggle="collapse" data-bs-target="#faq3">
                            <h5>Verilerim nasıl korunuyor?</h5>
                            <i class="fa fa-chevron-down"></i>
                        </div>
                        <div id="faq3" class="collapse faq-answer">
                            <p>Tüm verileriniz KVKK (Kişisel Verilerin Korunması Kanunu) kapsamında korunur. Verileriniz şifrelenerek saklanır ve asla üçüncü kişilerle paylaşılmaz.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KVKK Modal -->
<div class="modal fade" id="kvkkModal" tabindex="-1" aria-labelledby="kvkkModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kvkkModalLabel">Kişisel Verilerin Korunması Aydınlatma Metni</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p>Bu aydınlatma metni, 6698 sayılı Kişisel Verilerin Korunması Kanunu ("KVKK") kapsamında, <strong>AnatoliaRoot</strong> olarak tarafımıza ilettiğiniz kişisel verilerinizin işlenme amaçları, hukuki sebepleri, toplanma yöntemi, kimlere ve hangi amaçla aktarılabileceği ve KVKK kapsamındaki haklarınız hakkında sizi bilgilendirmek amacıyla hazırlanmıştır.</p>
                
                <h6>1. Kişisel Verilerin İşlenme Amacı</h6>
                <p>Fikir paylaşım formu aracılığıyla paylaştığınız fikir açıklaması bilgileriniz; yalnızca fikrinizin değerlendirilmesi, size geri dönüş yapılması ve hizmetlerimizin geliştirilmesi amacıyla işlenmektedir.</p>
                
                <p><strong>İsteğe Bağlı Kişisel Veriler:</strong> Ad Soyad ve e-posta adresi alanları isteğe bağlıdır. Bu alanlar doldurulmadan da form gönderilebilir. Doldurulması halinde sadece formun değerlendirilmesi ve dönüş yapılabilmesi amacıyla kullanılacaktır. Kişisel verileriniz hiçbir şekilde üçüncü kişilerle paylaşılmaz, ticari amaçla kullanılmaz.</p>
                
                <h6>2. Kişisel Verilerin Toplanma Yöntemi ve Hukuki Sebebi</h6>
                <p>Kişisel verileriniz, fikir paylaşım formu aracılığıyla elektronik ortamda toplanmaktadır. Verilerinizin işlenmesi, KVKK md. 5/1-a kapsamında "açık rızanızın bulunması" hukuki sebebine dayanmaktadır.</p>
                
                <h6>3. Kişisel Verilerin Aktarılması</h6>
                <p>Kişisel verileriniz, yukarıda belirtilen amaçlar dışında üçüncü kişilere aktarılmamaktadır.</p>
                
                <h6>4. Kişisel Verilerin Saklanma Süresi</h6>
                <p>Form ile paylaşılan kişisel veriler, 2 yıl süreyle saklanır ve bu sürenin sonunda güvenli şekilde silinir.</p>
                
                <h6>5. KVKK Kapsamındaki Haklarınız</h6>
                <p>KVKK md. 11 uyarınca sahip olduğunuz haklar:</p>
                <ul>
                    <li>Kişisel verilerinizin işlenip işlenmediğini öğrenme</li>
                    <li>Kişisel verileriniz işlenmişse buna ilişkin bilgi talep etme</li>
                    <li>Kişisel verilerinizin işlenme amacını ve bunların amacına uygun kullanılıp kullanılmadığını öğrenme</li>
                    <li>Yurt içinde veya yurt dışında kişisel verilerinizin aktarıldığı üçüncü kişileri bilme</li>
                    <li>Kişisel verilerinizin eksik veya yanlış işlenmiş olması hâlinde bunların düzeltilmesini isteme</li>
                    <li>KVKK'nın 7. maddesinde öngörülen şartlar çerçevesinde kişisel verilerinizin silinmesini veya yok edilmesini isteme</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- KVKK Açık Rıza Modal -->
<div class="modal fade" id="kvkkRizaModal" tabindex="-1" aria-labelledby="kvkkRizaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="kvkkRizaModalLabel">KVKK Açık Rıza Metni</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p>6698 sayılı Kişisel Verilerin Korunması Kanunu (KVKK) md. 5/1-a kapsamında, fikir paylaşım formu aracılığıyla paylaştığım kişisel verilerimin yukarıda belirtilen aydınlatma metni doğrultusunda toplanmasına, işlenmesine ve belirtilen amaçlarla kullanılmasına bilinçli ve açık rızamla izin veriyorum.</p>
                
                <p><strong>Önemli Not:</strong> Ad Soyad ve e-posta adresi alanları isteğe bağlıdır. Bu bilgileri paylaşmadan da fikrinizi gönderebilirsiniz. Paylaştığınız bilgiler sadece size geri dönüş yapabilmek amacıyla kullanılacaktır.</p>
            </div>
        </div>
    </div>
</div>

<style>
/* Hero Section */
.ideas-hero {
    background: linear-gradient(135deg, #d5ddd1 0%, #b1cfb1 100%);
    padding: 80px 0 60px 0;
    color: white;
    position: relative;
    overflow: hidden;
}

.ideas-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    opacity: 0.3;
}

.hero-content {
    position: relative;
    z-index: 2;
}

.hero-icon {
    margin-bottom: 30px;
}

.hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    margin-bottom: 20px;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

.hero-subtitle {
    font-size: 1.3rem;
    opacity: 0.9;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
}

/* Purpose Section */
.ideas-purpose {
    padding: 80px 0;
    background: #f8f9fa;
}

.purpose-card {
    background: white;
    border-radius: 20px;
    padding: 40px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
}

.purpose-card:hover {
    transform: translateY(-5px);
}

.purpose-icon {
    margin-bottom: 20px;
}

.purpose-card h3 {
    color: #333;
    margin-bottom: 20px;
    font-weight: 600;
}

.purpose-card p {
    color: #666;
    line-height: 1.6;
    font-size: 1.1rem;
}

/* How It Works Section */
.how-it-works {
    padding: 80px 0;
    background: white;
}

.section-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: #333;
    margin-bottom: 50px;
    text-align: center;
}

.steps-container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
    margin-top: 50px;
}

.step-item {
    text-align: center;
    padding: 30px 20px;
    background: #f8f9fa;
    border-radius: 15px;
    transition: all 0.3s ease;
}

.step-item:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
}

.step-icon {
    margin-bottom: 20px;
}

.step-item h4 {
    color: #333;
    margin-bottom: 15px;
    font-weight: 600;
}

.step-item p {
    color: #666;
    line-height: 1.5;
}

/* Why Share Section */
.why-share {
    padding: 80px 0;
    background: linear-gradient(135deg, #d5ddd1 0%, #b1cfb1 100%);
    color: #333;
}

.why-share-content h3 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 40px;
    text-align: center;
}

.benefits-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}

.benefit-item {
    text-align: center;
    padding: 30px 20px;
    background: rgba(255,255,255,0.8);
    border-radius: 15px;
    backdrop-filter: blur(10px);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid rgba(255,255,255,0.3);
}

.benefit-item:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
}

.benefit-icon {
    font-size: 3rem;
    margin-bottom: 20px;
    animation: benefitIconFloat 3s ease-in-out infinite;
}

.benefit-item:nth-child(1) .benefit-icon {
    color: #4CAF50;
    animation-delay: 0s;
}

.benefit-item:nth-child(2) .benefit-icon {
    color: #2196F3;
    animation-delay: 0.5s;
}

.benefit-item:nth-child(3) .benefit-icon {
    color: #FF9800;
    animation-delay: 1s;
}

.benefit-item h5 {
    font-size: 1.3rem;
    margin-bottom: 15px;
    font-weight: 600;
    color: #333;
}

.benefit-item p {
    line-height: 1.6;
    color: #666;
}

/* Form Section */
.ideas-form-section {
    padding: 80px 0;
    background: #f8f9fa;
}

.ideas-form-box {
    background: white;
    border-radius: 20px;
    padding: 40px;
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
}

.form-header {
    text-align: center;
    margin-bottom: 40px;
}

.form-header h3 {
    font-size: 2rem;
    font-weight: 700;
    color: #333;
    margin: 20px 0 10px 0;
}

.form-header p {
    color: #666;
    font-size: 1.1rem;
}

.ideas-form {
    max-width: 100%;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.form-group {
    margin-bottom: 25px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: #333;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid #e1e5e9;
    border-radius: 10px;
    font-size: 1rem;
    transition: all 0.3s ease;
    background: #f8f9fa;
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: #667eea;
    background: white;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.radio-group {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.radio-item {
    display: flex;
    align-items: center;
    cursor: pointer;
    padding: 15px;
    border: 2px solid #e1e5e9;
    border-radius: 10px;
    transition: all 0.3s ease;
}

.radio-item:hover {
    border-color: #667eea;
    background: #f8f9fa;
}

.radio-item input[type="radio"] {
    display: none;
}

.radio-custom {
    width: 20px;
    height: 20px;
    border: 2px solid #e1e5e9;
    border-radius: 50%;
    margin-right: 15px;
    position: relative;
    transition: all 0.3s ease;
}

.radio-item input[type="radio"]:checked + .radio-custom {
    border-color: #667eea;
    background: #667eea;
}

.radio-item input[type="radio"]:checked + .radio-custom::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 8px;
    height: 8px;
    background: white;
    border-radius: 50%;
}

.kvkk-section {
    margin: 30px 0;
    padding: 20px;
    background: #f8f9fa;
    border-radius: 10px;
}

.form-check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
}

.form-check-input {
    margin-top: 3px;
}

.form-check-label {
    font-size: 0.95rem;
    line-height: 1.5;
}

.form-check-label a {
    color: #667eea;
    text-decoration: underline;
    font-weight: 600;
}

.submit-btn {
    width: 100%;
    padding: 15px 30px;
    background: linear-gradient(135deg, #b1cfb1 0%, #388e3c 100%);
    color: white;
    border: none;
    outline: none;
    border-radius: 10px;
    font-size: 1.1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
}

.submit-btn:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, #388e3c 0%, #b1cfb1 100%);
    box-shadow: 0 10px 25px rgba(56, 142, 60, 0.3);
    border: none;
    outline: none;
}

/* FAQ Section */
.faq-section {
    padding: 80px 0;
    background: white;
}

.faq-container {
    max-width: 800px;
    margin: 0 auto;
}

.faq-item {
    margin-bottom: 20px;
    border: 1px solid #e1e5e9;
    border-radius: 10px;
    overflow: hidden;
}

.faq-question {
    padding: 20px;
    background: #f8f9fa;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: all 0.3s ease;
}

.faq-question:hover {
    background: #e9ecef;
}

.faq-question h5 {
    margin: 0;
    font-weight: 600;
    color: #333;
}

.faq-question i {
    transition: transform 0.3s ease;
}

.faq-question[aria-expanded="true"] i {
    transform: rotate(180deg);
}

.faq-answer {
    padding: 20px;
    background: white;
}

.faq-answer p {
    margin: 0;
    color: #666;
    line-height: 1.6;
}

/* Responsive Design */
@@media (max-width: 768px) {
    .hero-title {
        font-size: 2.5rem;
    }
    
    .form-row {
        grid-template-columns: 1fr;
    }
    
    .steps-container {
        grid-template-columns: 1fr;
    }
    
    .benefits-grid {
        grid-template-columns: 1fr;
    }
    
    .ideas-form-box {
        padding: 30px 20px;
    }
}

/* Animations */
@@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.animate__fadeInUp {
    animation: fadeInUp 0.6s ease-out;
}

/* Loading animation for submit button */
.submit-btn.loading {
    pointer-events: none;
    opacity: 0.7;
}

.submit-btn.loading span {
    opacity: 0;
}

.submit-btn.loading lottie-player {
    opacity: 1;
}

/* Fikir paylaşımı için özel animasyonlar */
.idea-lightbulb {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
}

.idea-lightbulb i {
    font-size: 4rem;
    color: #FFD700;
    animation: lightbulbGlow 2s ease-in-out infinite alternate;
    z-index: 2;
}

.light-rays {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255,215,0,0.3) 0%, transparent 70%);
    animation: lightRays 3s ease-in-out infinite;
}

@@keyframes lightbulbGlow {
    0% { 
        transform: scale(1);
        filter: drop-shadow(0 0 10px rgba(255,215,0,0.5));
    }
    100% { 
        transform: scale(1.1);
        filter: drop-shadow(0 0 20px rgba(255,215,0,0.8));
    }
}

@@keyframes lightRays {
    0%, 100% { 
        transform: scale(1);
        opacity: 0.5;
    }
    50% { 
        transform: scale(1.2);
        opacity: 0.8;
    }
}

.brain-creativity {
    position: relative;
    width: 80px;
    height: 80px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
}

.brain-creativity i {
    font-size: 3rem;
    color: #4CAF50;
    animation: brainThink 3s ease-in-out infinite;
    z-index: 2;
}

.thought-bubbles {
    position: absolute;
    width: 100%;
    height: 100%;
}

.thought-bubbles span {
    position: absolute;
    width: 8px;
    height: 8px;
    background: #4CAF50;
    border-radius: 50%;
    animation: thoughtFloat 2s ease-in-out infinite;
}

.thought-bubbles span:nth-child(1) {
    top: -10px;
    right: 20px;
    animation-delay: 0s;
}

.thought-bubbles span:nth-child(2) {
    top: 10px;
    right: -5px;
    animation-delay: 0.5s;
}

.thought-bubbles span:nth-child(3) {
    bottom: 5px;
    right: 15px;
    animation-delay: 1s;
}

@@keyframes brainThink {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.1) rotate(5deg); }
}

@@keyframes thoughtFloat {
    0%, 100% { 
        transform: translateY(0) scale(1);
        opacity: 0.7;
    }
    50% { 
        transform: translateY(-10px) scale(1.2);
        opacity: 1;
    }
}

.step-idea-share i,
.step-review i,
.step-feedback i,
.step-privacy i {
    font-size: 2.5rem;
    color: #667eea;
    animation: stepIconPulse 2s ease-in-out infinite;
}

.step-idea-share i { color: #4CAF50; }
.step-review i { color: #FF9800; }
.step-feedback i { color: #2196F3; }
.step-privacy i { color: #F44336; }

@@keyframes stepIconPulse {
    0%, 100% { 
        transform: scale(1);
        filter: drop-shadow(0 0 5px rgba(102, 126, 234, 0.3));
    }
    50% { 
        transform: scale(1.1);
        filter: drop-shadow(0 0 10px rgba(102, 126, 234, 0.6));
    }
}

.form-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px auto;
    display: flex;
    align-items: center;
    justify-content: center;
        background: linear-gradient(135deg, #cad9c7 0%, #b5d1b5 100%);
        border-radius: 50%;
    animation: formIconFloat 3s ease-in-out infinite;
}

.form-icon i {
    font-size: 2.5rem;
    color: white;
    animation: paperPlaneFly 2s ease-in-out infinite;
}

@@keyframes formIconFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

@@keyframes paperPlaneFly {
    0%, 100% { transform: rotate(0deg); }
    50% { transform: rotate(15deg); }
}

.submit-btn i {
    font-size: 1.2rem;
    animation: sendPulse 1.5s ease-in-out infinite;
}

@@keyframes sendPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
}

@@keyframes benefitIconFloat {
    0%, 100% { 
        transform: translateY(0) scale(1);
        filter: drop-shadow(0 0 5px rgba(0,0,0,0.2));
    }
    50% { 
        transform: translateY(-10px) scale(1.1);
        filter: drop-shadow(0 0 15px rgba(0,0,0,0.4));
    }
}

/* Pulse animation for icons */
@@keyframes pulse {
    0% { transform: scale(1); }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); }
}
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Form submission
    const ideasForm = document.getElementById('ideasForm');
    
    ideasForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        // Check KVKK checkboxes
        const kvkkAydinlatma = document.getElementById('kvkkAydinlatma');
        const kvkkRiza = document.getElementById('kvkkRiza');
        if (!kvkkAydinlatma.checked || !kvkkRiza.checked) {
            Swal.fire({
                icon: 'warning',
                title: 'KVKK Onayı Gerekli',
                text: 'Formu gönderebilmek için her iki KVKK onay kutusunu da işaretlemelisiniz.',
                confirmButtonText: 'Tamam'
            });
            return;
        }
        
        // Form verilerini hazırla ve gönder
        const formData = new FormData(this);
        
        // Sadece formSource alanını ekle (Türkçe ve tek)
        formData.append('formSource', 'Fikirler ve Projeler Sayfası');
        
        // Show loading state
        const submitBtn = this.querySelector('.submit-btn');
        submitBtn.classList.add('loading');
        
        try {
            const response = await fetch(this.action, {
                method: 'POST',
                body: formData,
                headers: { 'Accept': 'application/json' }
            });
            
            if (response.ok) {
                Swal.fire({
                    icon: 'success',
                    title: 'Fikriniz Başarıyla Gönderildi!',
                    text: 'Fikriniz yönetici ekibimize iletildi. En kısa sürede değerlendirilecek ve gerekirse size geri dönüş yapılacaktır.',
                    confirmButtonText: 'Teşekkürler'
                });
                this.reset();
            } else {
                throw new Error('Form gönderilemedi');
            }
        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Bir Hata Oluştu',
                text: 'Fikriniz gönderilirken bir hata oluştu. Lütfen tekrar deneyin.',
                confirmButtonText: 'Tamam'
            });
        } finally {
            submitBtn.classList.remove('loading');
        }
    });
    
    // FAQ animations
    const faqQuestions = document.querySelectorAll('.faq-question');
    faqQuestions.forEach(question => {
        question.addEventListener('click', function() {
            const icon = this.querySelector('i');
            const isExpanded = this.getAttribute('aria-expanded') === 'true';
            
            if (isExpanded) {
                icon.style.transform = 'rotate(0deg)';
            } else {
                icon.style.transform = 'rotate(180deg)';
            }
        });
    });
    
    // Scroll animations
    const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
    };
    
    const observer = new IntersectionObserver(function(entries) {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = 'translateY(0)';
            }
        });
    }, observerOptions);
    
    // Observe all animated elements
    document.querySelectorAll('.animate__animated').forEach(el => {
        el.style.opacity = '0';
        el.style.transform = 'translateY(30px)';
        el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
        observer.observe(el);
    });
});
</script> 